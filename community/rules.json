{
  "_meta": {
    "name": "community-response-rules",
    "version": "1.0.0",
    "source": "docs/MASTER-PROMPT.md 4.14 response rules table, counts, hours, tone",
    "read_by": "automation/W30.json (node 'Read rules'), automation/W31.json (hours and counts only)",
    "owner": "community-response-lead",
    "change_control": "Any edit runs evals/comment-cases.json (6B.1). Hide-word list and first 50 live replies are HUMAN GATES.",
    "resolution_order": [
      "own_data_posted",
      "sensitive",
      "abuse",
      "spam",
      "competitor",
      "complaint",
      "advice_question",
      "objection",
      "question",
      "interest",
      "praise",
      "off_topic"
    ],
    "case_resolution": "case = intent, except: if fais_risk is true and intent is question, objection or interest the case becomes advice_question; if needs_human is true and intent is not complaint or sensitive, the public reply is suppressed and the case escalates (human_within_seconds 1800) while still allowing a hide for abuse, spam, competitor and own_data_posted."
  },
  "global": {
    "timezone": "Africa/Johannesburg",
    "reply_hours": { "start": "07:00", "end": "22:00" },
    "overnight_queue_release": "07:15",
    "hide_runs_24_7": true,
    "new_ad_watch": { "duration_seconds": 7200, "public_sla_seconds": 300 },
    "default_public_sla_seconds": 900,
    "max_public_replies_per_comment": 1,
    "max_private_replies_per_comment": 1,
    "private_reply_window_days": 7,
    "max_public_exchanges_per_person_per_post": 2,
    "after_max_exchanges": "post the 'continue privately' line once, then stop",
    "never_reply_publicly_to_reply_to_a_reply": true,
    "public_reply_max_sentences": 2,
    "public_reply_reading_grade": [5, 7],
    "public_reply_rules": {
      "exclamation_marks": false,
      "emojis": "only if the commenter used them",
      "bare_links": false,
      "link_goes_in": "private reply only",
      "person": "third person about the adviser and about SortMyCover; no 'you should'",
      "banned_content": ["premium", "price or rand amount", "product name", "insurer name", "cover amount", "comparison", "suitability", "tax", "you should", "guaranteed", "hot leads", "financial advice"],
      "first_name": "use if visible",
      "gate": "regex lint plus the shared FAIS guardrail (conversation/prompts/guardrail.md) before every send; on fail use the fixed deferral template"
    },
    "private_reply_rules": {
      "first_message_discloses_automation": true,
      "links_max": 1,
      "link_type_preferred": "ctwa",
      "ctwa_ref_pattern": "cmt_{ad_id}",
      "fallback_link": "page link with utm_source=meta&utm_medium=comment&utm_campaign=cmt_{ad_id}",
      "qualifying_question": "none in the private reply; one age-band question only after the person replies (W31 then W03)",
      "no_reply_means": "nothing further (no consent to market)"
    },
    "model": {
      "classify": "claude-haiku-4-5-20251001",
      "draft": "claude-haiku-4-5-20251001",
      "escalation": "claude-sonnet-5-5",
      "sonnet_only_when": "intent is objection, needs_human is false, and the Haiku draft failed the first guardrail pass"
    }
  },
  "cases": {
    "question": {
      "description": "Question about the call or process",
      "public_reply": true,
      "public_template": "question_process",
      "public_draft_from_faq": true,
      "public_max_sentences": 2,
      "private_reply": true,
      "private_template": "private_question",
      "private_after_public_seconds": 300,
      "hide": false,
      "like": false,
      "other_actions": [],
      "public_sla_seconds": 900,
      "new_ad_public_sla_seconds": 300,
      "hours_bound": true,
      "escalation": null
    },
    "interest": {
      "description": "Wants to book or take part",
      "public_reply": true,
      "public_template": "interest_thanks",
      "public_draft_from_faq": false,
      "public_max_sentences": 2,
      "private_reply": true,
      "private_template": "private_interest",
      "private_after_public_seconds": 300,
      "hide": false,
      "like": true,
      "other_actions": ["on_person_reply_hand_to_W03_consent_then_qualify"],
      "public_sla_seconds": 900,
      "new_ad_public_sla_seconds": 300,
      "hours_bound": true,
      "escalation": null
    },
    "objection": {
      "description": "Doubt or suspicion: scam, they will sell me, what is the catch",
      "public_reply": true,
      "public_template": "objection_calm",
      "public_draft_from_faq": true,
      "public_max_sentences": 2,
      "private_reply": true,
      "private_template": "private_objection",
      "private_after_public_seconds": 300,
      "hide": false,
      "like": false,
      "other_actions": ["never_argue", "one_public_reply_only", "log_objection_theme_for_creative_strategist"],
      "public_sla_seconds": 900,
      "new_ad_public_sla_seconds": 300,
      "hours_bound": true,
      "escalation": null,
      "theme_rule": "an objection theme seen 3 times becomes a line in the ad or the FAQ (creative-strategist)"
    },
    "advice_question": {
      "description": "Product, price, cover amount, insurer or advice question (fais_risk true)",
      "public_reply": "deferral",
      "public_template": "deferral_advice",
      "public_draft_from_faq": false,
      "public_max_sentences": 2,
      "private_reply": true,
      "private_template": "private_advice",
      "private_after_public_seconds": 300,
      "hide": false,
      "like": false,
      "other_actions": ["log_for_creative_insight"],
      "public_sla_seconds": 900,
      "new_ad_public_sla_seconds": 300,
      "hours_bound": true,
      "escalation": null,
      "note": "The reply is always the fixed deferral template. No LLM free text reaches the public thread."
    },
    "complaint": {
      "description": "Complaint about SortMyCover, an adviser or a call",
      "public_reply": true,
      "public_template": "complaint_ack",
      "public_draft_from_faq": false,
      "public_max_sentences": 2,
      "private_reply": true,
      "private_template": "private_complaint",
      "private_after_public_seconds": 300,
      "hide": false,
      "like": false,
      "other_actions": ["raise_escalation", "log_to_obligations_register_complaints"],
      "public_sla_seconds": 600,
      "new_ad_public_sla_seconds": 300,
      "hours_bound": true,
      "escalation": {
        "kind": "complaint",
        "to": ["Jonathan", "KG"],
        "channel": "W22 WhatsApp with console deep link",
        "human_within_seconds": 1800,
        "note": "Acknowledge once publicly, no detail. Complaints channel SLA in 2.1.7 is 48 h; the 30 min target is the first human touch."
      }
    },
    "praise": {
      "description": "Thanks or positive remark",
      "public_reply": true,
      "public_template": "praise_thanks",
      "public_draft_from_faq": false,
      "public_max_sentences": 1,
      "private_reply": false,
      "private_template": null,
      "private_after_public_seconds": null,
      "hide": false,
      "like": true,
      "other_actions": ["one_reply_per_person_per_post", "skip_emoji_only_and_repeat_praise"],
      "public_sla_seconds": 7200,
      "new_ad_public_sla_seconds": 7200,
      "hours_bound": true,
      "batch": true,
      "escalation": null
    },
    "spam": {
      "description": "Spam, scams, link-dropping, bots",
      "public_reply": false,
      "public_template": null,
      "private_reply": false,
      "private_template": null,
      "hide": true,
      "like": false,
      "other_actions": ["block_repeat_offender_after_2_hidden_comments", "never_delete"],
      "public_sla_seconds": null,
      "hide_sla_seconds": 600,
      "hours_bound": false,
      "escalation": null
    },
    "competitor": {
      "description": "Competitor links or recruiting our commenters",
      "public_reply": false,
      "public_template": null,
      "private_reply": false,
      "private_template": null,
      "hide": true,
      "like": false,
      "other_actions": ["block_repeat_offender_after_2_hidden_comments", "never_delete"],
      "public_sla_seconds": null,
      "hide_sla_seconds": 600,
      "hours_bound": false,
      "escalation": null
    },
    "abuse": {
      "description": "Slurs, threats, harassment",
      "public_reply": false,
      "public_template": null,
      "private_reply": false,
      "private_template": null,
      "hide": true,
      "like": false,
      "other_actions": ["block_repeat_offender_after_2_hidden_comments", "never_delete", "if_thread_hostile_flag_ad_for_pause_review"],
      "public_sla_seconds": null,
      "hide_sla_seconds": 600,
      "hours_bound": false,
      "escalation": { "kind": "hostile_thread", "to": ["media-buyer"], "condition": "3 or more hidden abuse comments on one ad in 60 minutes", "human_within_seconds": null }
    },
    "own_data_posted": {
      "description": "Person posted their own number, ID or email",
      "public_reply": false,
      "public_template": null,
      "private_reply": true,
      "private_template": "private_own_data",
      "private_after_public_seconds": null,
      "private_within_seconds": 300,
      "hide": true,
      "like": false,
      "other_actions": ["hide_immediately_popia", "redact_text_before_storage", "do_not_forward_number_to_llm_drafts"],
      "public_sla_seconds": null,
      "hide_sla_seconds": 300,
      "hours_bound": false,
      "private_hours_bound": true,
      "escalation": null
    },
    "sensitive": {
      "description": "Illness, bereavement, claims, debt distress",
      "public_reply": false,
      "public_template": null,
      "private_reply": "human_only",
      "private_template": "private_sensitive_human_template",
      "private_after_public_seconds": null,
      "hide": false,
      "like": false,
      "other_actions": ["human_writes_and_sends", "no_automation_message", "never_forward_health_detail_beyond_the_single_classify_call"],
      "public_sla_seconds": null,
      "hours_bound": true,
      "escalation": {
        "kind": "sensitive",
        "to": ["Jonathan", "KG"],
        "channel": "W22 WhatsApp with console deep link",
        "human_within_seconds": 1800
      }
    },
    "off_topic": {
      "description": "Unrelated chatter, emoji only, tags",
      "public_reply": false,
      "public_template": null,
      "private_reply": false,
      "private_template": null,
      "hide": false,
      "like": false,
      "other_actions": ["leave_visible"],
      "public_sla_seconds": null,
      "hours_bound": false,
      "escalation": null
    }
  },
  "dm_rules": {
    "surfaces": ["messenger", "instagram_dm"],
    "disclose_first_message": true,
    "never_dm_people_who_did_not_comment_or_message": true,
    "window": "24 h from the person's last message; one private reply to a comment within 7 days opens the thread only if the person answers",
    "max_faq_answers_before_cta": 2,
    "qualifying_questions_in_dm": 1,
    "link_type": "ctwa",
    "stop_after_link": true,
    "handoff_phrases_en": ["person", "human", "real person", "agent", "manager", "speak to someone"],
    "handoff_phrases_af": ["mens", "'n persoon", "regte persoon", "bestuurder", "praat met iemand"],
    "handoff_action": "pause bot, raise escalation (W22 to Jonathan/KG), send one human-coming line",
    "no_reply_means": "nothing further"
  },
  "hygiene": {
    "daily_sentiment_summary_per_ad": true,
    "objection_theme_threshold": 3,
    "hostile_thread_pause_review": true,
    "flag_negative_feedback_prone_threads_to": "media-buyer",
    "weekly_review_sample_size": 20,
    "weekly_reviewers": ["Jonathan", "KG"]
  }
}
