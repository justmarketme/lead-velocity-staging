#!/bin/sh
# Blocks commits that add secret files or secret-looking values (0.3 #10).
# Enable once per clone: git config core.hooksPath .githooks   (npm install does this via the "prepare" script)
fail=0
files=$(git diff --cached --name-only --diff-filter=ACM)
for f in $files; do
  case "$f" in
    .env.example|*/.env.example) ;;
    .env|.env.*|*/.env|*/.env.*|*.pem|*.key|credentials*|*/credentials*|*.zip|.claude/settings.local.json)
      echo "pre-commit: refusing to commit secret/local file: $f"; fail=1 ;;
  esac
done
patterns='sk-ant-[A-Za-z0-9_-]{20,}|sk-or-v1-[A-Za-z0-9]{20,}|sk-proj-[A-Za-z0-9_-]{20,}|sk_(live|test)_[A-Za-z0-9]{20,}|sk_[a-f0-9]{40,}|pk_live_[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{35}|re_[A-Za-z0-9]{24,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|xox[abp]-[A-Za-z0-9-]{10,}|EAA[A-Za-z0-9]{100,}|AC[0-9a-f]{32}|SK[0-9a-f]{32}|sb_secret_[A-Za-z0-9_-]{20,}|sbp_[a-f0-9]{40}|postgres(ql)?://[^:@/[:space:]]+:[^@[:space:]$<{]{4,}@|SERVICE_ROLE_KEY[[:space:]]*[:=][[:space:]]*["'"'"']?eyJ'
hits=$(git diff --cached -U0 --diff-filter=ACM | grep '^+' | grep -v '^+++' | grep -En "$patterns")
if [ -n "$hits" ]; then
  echo "pre-commit: possible secret in staged changes:"; echo "$hits" | cut -c1-120; fail=1
fi
# A Supabase JWT is only OK if its role is anon; service_role (or anything else) is refused.
if command -v node >/dev/null 2>&1; then
  jwts=$(git diff --cached -U0 --diff-filter=ACM | grep '^+' | grep -v '^+++' | grep -Eo 'eyJ[A-Za-z0-9_-]{15,}\.eyJ[A-Za-z0-9_-]{15,}\.[A-Za-z0-9_-]{10,}' | sort -u)
  for t in $jwts; do
    role=$(node -e 'try{console.log(JSON.parse(Buffer.from(process.argv[1].split(".")[1],"base64url").toString()).role||"")}catch(e){console.log("")}' "$t")
    if [ "$role" = "service_role" ]; then echo "pre-commit: staged JWT with role=service_role"; fail=1; fi
  done
fi
[ $fail -eq 0 ] || { echo "Move the value to .env (git-ignored). If this is a false positive, fix the pattern in .githooks/pre-commit."; exit 1; }
