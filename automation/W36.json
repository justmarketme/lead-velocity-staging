        "method": "POST",
        "url": "=https://graph.microsoft.com/v1.0/users/{{ $env.HOWZIT_MAILBOX }}/sendMail",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: { subject: $json.subject, body: { contentType: 'Text', content: $json.text }, toRecipients: [ { emailAddress: { address: $json.to } } ] }, saveToSentItems: true }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 10000
        }
      },
      "credentials": {
