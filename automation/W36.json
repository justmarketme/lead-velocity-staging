    {
      "name": "Plan requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// FAQ entries are read by uid from Capital Legacy's public content API (the FAQ page paginates and reorders);\n// pages by URL. Without a master ref the FAQ requests fail and are reported as \"could not read\".\nconst L = require('lv-automation').clWatch;\nconst r = $input.first().json || {};\nlet ref = '';\ntry { ref = L.masterRef(r.body ?? r.data); } catch (e) { ref = ''; }\nreturn L.requestPlan(L.loadWatch(), ref).map((p) => ({ json: p }));"
      },
      "id": "smc-w36-4",
      "position": [
        960,
        300
      ]
    },
    {
      "name": "Fetch Capital Legacy page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "SortMyCover content check (+https://sortmycover.co.za)"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          },
          "timeout": 20000,
          "redirect": {
            "redirect": {
              "followRedirects": true,
              "maxRedirects": 5
            }
          },
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
