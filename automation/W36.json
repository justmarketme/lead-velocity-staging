      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Sources and baseline hashes: sites/sortmycover/config/capital-legacy-watch.json (read from the repo mount).\nconst L = require('lv-automation').clWatch;\nconst w = L.loadWatch();\nreturn [{ json: { content_api: w.content_api, sources: w.sources.length } }];"
