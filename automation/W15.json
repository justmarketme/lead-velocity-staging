    {
      "id": "n08",
      "name": "Entry (w15.entryFrom + isStop)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = require('lv-automation').w15;\nreturn $input.all().map((i) => { const e = L.entryFrom(i.json); return { json: { ...e, stop: e.force || L.isStop(e.text), lead_id: e.lead_id || (i.json.lead && i.json.lead.id) || null, now: Date.now() } }; });"
      }
    },
    {
      "id": "n09",
      "name": "STOP? (else nothing: W07 owns every other message)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ String($json.stop && !!($json.mobile || $json.lead_id)) }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n10",
      "name": "Load leads, live bookings, brokers, suppression for this number",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH h AS (SELECT public.smc_hash_contact(COALESCE($1, (SELECT x.phone FROM public.leads x WHERE x.id = $2::uuid))) AS mh,\n                  COALESCE($1, (SELECT y.phone FROM public.leads y WHERE y.id = $2::uuid)) AS mobile)\nSELECT h.mh AS mobile_hash, h.mobile,\n       EXISTS (SELECT 1 FROM public.suppression s WHERE s.mobile_hash = h.mh AND s.source = 'stop') AS already_suppressed,\n       COALESCE((SELECT jsonb_agg(jsonb_build_object('id', l.id, 'first_name', l.first_name, 'phone', l.phone, 'broker_id', l.broker_id,\n                  'brand_id', l.brand_id, 'opted_out_at', l.opted_out_at, 'language', l.language))\n                   FROM public.leads l WHERE l.brand_id IS NOT NULL AND (l.dedupe_hash = h.mh OR l.id = $2::uuid)), '[]'::jsonb) AS leads,\n       COALESCE((SELECT jsonb_agg(jsonb_build_object('id', a.id, 'lead_id', a.client_id, 'broker_id', a.broker_id, 'status', a.status,\n                  'graph_event_id', a.graph_event_id, 'start', a.appointment_date, 'method', a.method))\n                   FROM public.appointments a JOIN public.leads la ON la.id = a.client_id\n                  WHERE a.brand_id IS NOT NULL AND a.status IN ('booked','confirmed') AND (la.dedupe_hash = h.mh OR la.id = $2::uuid)), '[]'::jsonb) AS bookings,\n       COALESCE((SELECT jsonb_agg(jsonb_build_object('id', b.id, 'whatsapp_number', b.whatsapp_number, 'email', b.email, 'contact_person', b.contact_person,\n                  'calendar_email', b.calendar_email,\n                  'last_inbound_at', (SELECT max(c.created_at) FROM public.communications c WHERE c.broker_id = b.id AND c.lead_id IS NULL AND c.direction = 'inbound' AND c.sender_type = 'broker')))\n                   FROM public.brokers b\n                  WHERE b.id IN (SELECT lb.broker_id FROM public.leads lb WHERE lb.dedupe_hash = h.mh OR lb.id = $2::uuid)), '[]'::jsonb) AS brokers\n  FROM h;",
        "options": {
          "queryReplacement": "={{ [$json.mobile || null, $json.lead_id || null] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "n11",
      "name": "Plan opt-out (w15.planOptOut)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = require('lv-automation').w15;\nconst e = $('STOP? (else nothing: W07 owns every other message)').first().json;\nconst ctx = $input.first().json;\nconst language = (ctx.leads || []).map((l) => l.language).find(Boolean) || e.language || 'en';\nconst plan = L.planOptOut({ mobile: e.mobile || ctx.mobile, text: e.text, channel: e.channel, force: e.force, now: e.now, language,\n  leads: ctx.leads || [], bookings: ctx.bookings || [], brokers: ctx.brokers || [], already_suppressed: ctx.already_suppressed, booking_mode: $env.W15_STOP_BOOKING_MODE });\nreturn [{ json: { e, ctx, plan } }];"
      }
    },
    {
      "id": "n12",
      "name": "First STOP for this number? (a repeat is a no-op)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ String($json.plan.handled && !$json.plan.duplicate) }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n13",
      "name": "Already opted out: nothing, no second confirmation",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1320,
