    {
      "id": "n14",
      "name": "Opt out + suppress + release bookings (one statement; the suppression insert is the claim)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH sup AS (\n  INSERT INTO public.suppression (mobile_hash, source, brand_id, lead_id, note)\n  SELECT public.smc_hash_contact($1), 'stop', NULL, $2::uuid, $3\n   WHERE $1 IS NOT NULL AND $1 <> ''\n  ON CONFLICT (mobile_hash, source) DO NOTHING\n  RETURNING id),\nclaim AS (SELECT (EXISTS (SELECT 1 FROM sup) OR $1 IS NULL OR $1 = '') AS ok),\nupd AS (\n  UPDATE public.leads l\n     SET opted_out_at = COALESCE(l.opted_out_at, now()), stage = 'opted_out', updated_at = now()\n   WHERE l.id IN (SELECT jsonb_array_elements_text($4::jsonb)::uuid) AND (SELECT ok FROM claim)\n  RETURNING l.id),\nbk AS (\n  UPDATE public.appointments a\n     SET status = 'cancelled', cancelled_at = now(), reason_notes = 'lead_opted_out', updated_at = now()\n   WHERE a.id IN (SELECT jsonb_array_elements_text($5::jsonb)::uuid) AND a.status IN ('booked','confirmed') AND (SELECT ok FROM claim)\n  RETURNING a.id),\nact AS (\n  INSERT INTO public.lead_activities (lead_id, brand_id, broker_id, workflow, actor_type, activity_type, payload, occurred_at, idempotency_key)\n  SELECT (x->>'lead_id')::uuid, (x->>'brand_id')::uuid, (x->>'broker_id')::uuid, 'W15', 'lead', 'opted_out', x->'payload', now(), x->>'idempotency_key'\n    FROM jsonb_array_elements($6::jsonb) x\n   WHERE (SELECT ok FROM claim)\n  ON CONFLICT (idempotency_key) DO NOTHING\n  RETURNING id)\nSELECT (SELECT ok FROM claim) AS claimed, (SELECT count(*) FROM upd)::int AS leads_opted_out, (SELECT count(*) FROM bk)::int AS bookings_cancelled, (SELECT count(*) FROM act)::int AS activities;",
        "options": {
          "queryReplacement": "={{ [$json.e.mobile || $json.ctx.mobile || '', ($json.plan.suppression && $json.plan.suppression.lead_id) || null, ($json.plan.suppression && $json.plan.suppression.note) || 'W15', JSON.stringify($json.plan.lead_updates.map((u) => u.id)), JSON.stringify($json.plan.booking_cancels.map((b) => b.booking_id)), JSON.stringify($json.plan.activities)] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "n15",
      "name": "Fan out (W09, Graph delete, broker notices, one confirmation)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = require('lv-automation').w15;\nif (!$input.first().json.claimed) return []; // lost a race with a parallel STOP: the winner does everything\nconst p = $('Plan opt-out (w15.planOptOut)').first().json;\nconst out = [];\nfor (const w of p.plan.w09) out.push({ json: { kind: 'w09', ...w } });\nconst brokers = new Map((p.ctx.brokers || []).map((b) => [String(b.id), b]));\nfor (const b of p.plan.booking_cancels) if (b.graph_event_id) out.push({ json: { kind: 'graph_delete', broker_id: b.broker_id, op: 'graph_token', graph_event_id: b.graph_event_id, calendar_email: (brokers.get(String(b.broker_id)) || {}).calendar_email || null } });\nfor (const nt of p.plan.broker_notices) {\n  if (nt.channel === 'email') { if (nt.to) out.push({ json: { kind: 'broker_email', to: nt.to, subject: nt.subject, text: nt.text, lead_id: nt.lead_id } }); continue; }\n  if (!nt.to || nt.mode === 'held_no_template') { out.push({ json: { kind: 'broker_held', lead_id: nt.lead_id, broker_id: nt.broker_id } }); continue; }\n  out.push({ json: { kind: 'broker_wa', lead_id: nt.lead_id, wa: nt.mode === 'session' ? L.waText(nt.to, nt.text) : L.brokerTemplate(nt.to, nt) } });\n}\nconst cf = p.plan.confirmation;\nif (cf) out.push({ json: { kind: cf.channel === 'sms' ? 'confirm_sms' : 'confirm_wa', lead_id: cf.lead_id, wa: L.waText(cf.to, cf.text), sms: { to: cf.to, text: cf.text }, text: cf.text, to: cf.to } });\nreturn out;"
      }
    },
