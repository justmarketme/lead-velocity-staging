        "query": "INSERT INTO public.lead_activities (lead_id, brand_id, broker_id, actor_type, activity_type, payload, occurred_at, idempotency_key)\nSELECT l.id, l.brand_id, l.broker_id, 'system', 'email_verify_skipped', jsonb_build_object('reason', $2::text), now(), 'ev:skip:' || l.id::text || ':' || $2 || ':' || to_char(now(), 'YYYYMMDDHH24')\n  FROM public.leads l WHERE l.id = NULLIF($1, '')::uuid AND l.brand_id IS NOT NULL AND $2 NOT IN ('recently_sent', 'already_verified')\nON CONFLICT (idempotency_key) DO NOTHING;",
        "options": {
          "queryReplacement": "={{ [ $json.lead_id || '', $json.reason || 'unknown' ] }}"
