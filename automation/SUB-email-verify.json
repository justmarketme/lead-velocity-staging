    {
      "name": "Load lead (issue)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "credentials": {
        "postgres": {
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.id::text AS id, l.first_name, l.email, l.email_verified, l.email_verify_code_hash, l.email_verify_sent_at,\n       l.email_verify_expires_at, l.email_verify_attempts, l.opted_out_at, l.phone, l.brand_id::text AS brand_id, l.broker_id::text AS broker_id,\n       b.contact_person AS adviser_name\n  FROM public.leads l LEFT JOIN public.brokers b ON b.id = l.broker_id\n WHERE l.id = NULLIF($1, '')::uuid AND l.brand_id IS NOT NULL;",
        "options": {
          "queryReplacement": "={{ [ $json.lead_id ] }}"
        }
      },
      "id": "smc-email-verify-5",
      "position": [
        1100,
        340
      ]
    },
    {
      "name": "Plan issue (code + link, 10-min gap)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const L = require('lv-automation').subEmailVerify;\nreturn { json: { lead_id: $json.id, brand_id: $json.brand_id, broker_id: $json.broker_id, email: $json.email, ...L.issuePlan($json.id ? $json : null, $env, Date.now()) } };"
