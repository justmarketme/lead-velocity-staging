          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $env.DRY_RUN_SENDS !== 'true' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "smc-email-verify-9",
      "position": [
        1980,
        380
      ]
    },
    {
      "name": "Resend POST /emails (hello@sortmycover.co.za)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $('Plan issue (code + link, 10-min gap)').item.json.resend.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('Plan issue (code + link, 10-min gap)').item.json.resend.headers.Authorization }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Plan issue (code + link, 10-min gap)').item.json.resend.headers['Idempotency-Key'] }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Plan issue (code + link, 10-min gap)').item.json.resend.body) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        }
      },
      "id": "smc-email-verify-10",
      "position": [
        2200,
        300
      ]
    },
    {
      "name": "Dry-run stub (Resend)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// DRY_RUN_SENDS=true: no email leaves the box; the evidence row is still written with a dry: id.\nreturn { json: { statusCode: 200, body: { id: 'dry:ev:' + $('Plan issue (code + link, 10-min gap)').item.json.lead_id } } };"
      },
      "id": "smc-email-verify-11",
      "position": [
        2420,
        340
      ]
    },
    {
      "name": "Interpret Resend response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const L = require('lv-automation').subEmailVerify;\nreturn { json: L.interpretResend($json) };"
      },
      "id": "smc-email-verify-12",
      "position": [
        2640,
        380
      ]
    },
    {
      "name": "Log email in communications (CRM timeline)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "credentials": {
        "postgres": {
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "-- The CRM's UnifiedCommunicationHub shows this row on the lead. Content never holds the code or the link.\nINSERT INTO public.communications (brand_id, channel, direction, sender_type, recipient_type, recipient_contact, subject, content, status, external_id, failed_reason, lead_id, broker_id, author, workflow, template_name, metadata)\nVALUES (NULLIF($1, '')::uuid, 'email', 'outbound', 'system', 'client', $2, $3, '[email verification: code + link]', $4, NULLIF($5, ''), NULLIF($6, ''), $7::uuid, NULLIF($8, '')::uuid, 'system', 'smc-email-verify', 'email_verification',\n        jsonb_build_object('provider', 'resend', 'from', $9::text, 'dry_run', $5 LIKE 'dry:%'))\nON CONFLICT (channel, external_id) WHERE brand_id IS NOT NULL AND external_id IS NOT NULL DO NOTHING;",
        "options": {
          "queryReplacement": "={{ (() => { const p = $('Plan issue (code + link, 10-min gap)').item.json; return [ p.brand_id || '', p.email, p.resend.body.subject, $json.ok ? 'sent' : 'failed', $json.external_id || '', $json.error || '', p.lead_id, p.broker_id || '', p.resend.body.from ]; })() }}"
        }
      },
      "id": "smc-email-verify-13",
      "position": [
        2860,
        300
      ]
    },
    {
      "name": "Log skipped issue (timeline)",
