    {
      "name": "Store code hash + timeline (before the send)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "credentials": {
        "postgres": {
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Only the hash is stored (capture-v2 issueEmailVerification). A newer email replaces the older code.\nWITH u AS (\n  UPDATE public.leads SET email_verify_code_hash = $2, email_verify_sent_at = $3::timestamptz, email_verify_expires_at = $4::timestamptz,\n                          email_verify_attempts = 0, updated_at = now()\n   WHERE id = $1::uuid AND brand_id IS NOT NULL AND email_verified IS NOT TRUE\n  RETURNING id, brand_id, broker_id)\nINSERT INTO public.lead_activities (lead_id, brand_id, broker_id, actor_type, activity_type, payload, occurred_at, idempotency_key)\nSELECT u.id, u.brand_id, u.broker_id, 'system', 'email_verify_sent', jsonb_build_object('via', 'resend', 'expires_at', $4::text), now(), 'ev:sent:' || u.id::text || ':' || $3\n  FROM u\nON CONFLICT (idempotency_key) DO NOTHING\nRETURNING lead_id::text AS lead_id;",
        "options": {
          "queryReplacement": "={{ [ $json.lead_id, $json.set.email_verify_code_hash, $json.set.email_verify_sent_at, $json.set.email_verify_expires_at ] }}"
        }
      },
      "id": "smc-email-verify-8",
      "position": [
        1760,
        340
      ]
    },
