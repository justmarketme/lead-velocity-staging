      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// One reply to the typed code (the lead just wrote: inside the 24-h window). Through smc-whatsapp-send, so\n// WHATSAPP_PROVIDER switches it; the sub records the communications row (record:true).\nconst p = $('Check the typed code').item.json;\nconst n = $('Normalise input').item.json;\nreturn { json: { kind: 'prebuilt', wa: { messaging_product: 'whatsapp', to: String(n.to || p.phone || '').replace(/\\D/g, ''), type: 'text', text: { body: p.reply } }, record: true, caller: 'smc-email-verify', lead_id: p.lead_id, correlation: 'ev:reply:' + (n.wamid || p.lead_id + ':' + Date.now()) } };"
