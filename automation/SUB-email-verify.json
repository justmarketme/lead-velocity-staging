{
  "id": "smc-email-verify",
  "name": "Email Verify (Resend code + link, clause 5.8)",
  "nodes": [
    {
      "name": "Called by W05 / W28 (issue) or W07 (typed code)",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
