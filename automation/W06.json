    {
      "id": "n04",
      "name": "Load lead, broker, brand, live booking",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.id, l.brand_id, l.origin, l.first_name, l.phone, l.language, l.broker_id, l.routed_at, l.stage, l.opted_out_at, l.duplicate_of,\n       l.disqualified_reason, l.first_message_at,\n       EXISTS (SELECT 1 FROM public.suppression s WHERE s.mobile_hash = public.smc_hash_contact(l.phone) AND (s.brand_id IS NULL OR s.brand_id = l.brand_id)) AS suppressed,\n       b.firm_name AS practice_name, b.fsp_number, b.contact_person AS adviser_name, b.intro_card_url,\n       br.booking_ui,\n       (SELECT to_jsonb(q) FROM (SELECT a.id, a.created_at, a.appointment_date AS start, a.method\n                                   FROM public.appointments a\n                                  WHERE a.client_id = l.id AND a.status IN ('booked','confirmed') AND (a.id = $2::uuid OR $2::uuid IS NULL)\n                                  ORDER BY a.created_at DESC LIMIT 1) q) AS booking\n  FROM public.leads l\n  JOIN public.brokers b ON b.id = l.broker_id\n  JOIN public.brands br ON br.id = l.brand_id\n WHERE l.id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [$json.lead_id, $json.booking_id || null] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "n05",
      "name": "Hold for the in-page booking? (w06.holdSeconds)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = require('lv-automation').w06;\nconst ev = $('Called by W01 / W05 / W07 (op routed | skip | booking | status)').first().json;\nconst l = $input.first().json;\nif (!l || !l.id) return [{ json: { blocked: 'no_lead', lead_id: ev.lead_id, hold_s: 0 } }];\nconst block = L.blockReason(l);\nreturn [{ json: { ev, l, blocked: block, hold_s: block ? 0 : L.holdSeconds(l, ev.op) } }];"
      }
    },
