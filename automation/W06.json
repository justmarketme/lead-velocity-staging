    {
      "id": "n20",
      "name": "Evidence rows (w06.communicationRow + sentUpdate)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = require('lv-automation').w06;\nconst p = $('Plan card (w06.planFirstTouch + toCloudApi)').first().json;\nconst wamid = L.wamidOf($input.first().json);\nconst sentAt = Date.now();\nconst b = { id: p.l.broker_id };\nconst comm = L.communicationRow(p.plan, { ...p.l }, b, wamid, sentAt);\nconst upd = wamid ? L.sentUpdate(p.l, p.plan, wamid, sentAt) : null;\nconst sms = wamid ? null : { to: p.l.phone, text: L.smsText(p.plan.template, p.plan.variables) };\nreturn [{ json: { ...p, wamid, comm, upd, sms, slow: upd ? !upd.within_60s : false, error: wamid ? null : JSON.stringify($input.first().json.error || $input.first().json).slice(0, 500) } }];"
      }
    },
    {
      "id": "n21",
      "name": "Log card + stamp lead + timeline (one statement; last_contact_at only with a wamid)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        3740,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH c AS (\n  INSERT INTO public.communications (brand_id, channel, direction, sender_type, recipient_type, recipient_contact, content, status, external_id,\n                                     lead_id, broker_id, author, workflow, template_name, template_category, latency_ms, failed_reason, metadata)\n  SELECT $1::uuid, 'whatsapp', 'outbound', 'system', 'client', $2, $3, CASE WHEN $4 <> '' THEN 'sent' ELSE 'failed' END, NULLIF($4, ''),\n         $5::uuid, $6::uuid, 'system', 'W06', $7, 'UTILITY', $8::int, NULLIF($9, ''), $10::jsonb\n  ON CONFLICT (channel, external_id) WHERE brand_id IS NOT NULL AND external_id IS NOT NULL DO NOTHING\n  RETURNING id),\nu AS (\n  UPDATE public.leads l\n     SET first_message_at = COALESCE(l.first_message_at, now()), disclosure_msg_id = $4,\n         last_contact_at = now(), stage = CASE WHEN l.stage IS NULL OR l.stage = 'new' THEN 'disclosed' ELSE l.stage END, updated_at = now()\n   WHERE l.id = $5::uuid AND $4 <> ''\n  RETURNING l.id)\nINSERT INTO public.lead_activities (lead_id, brand_id, broker_id, workflow, actor_type, activity_type, payload, occurred_at, idempotency_key)\nVALUES ($5::uuid, $1::uuid, $6::uuid, 'W06', 'system', CASE WHEN $4 <> '' THEN 'first_touch_sent' ELSE 'first_touch_failed' END,\n        jsonb_build_object('template', $7::text, 'wamid', NULLIF($4, ''), 'latency_ms', $8::int, 'trigger', $11::text), now(), 'w06:sent:' || $5::text)\nON CONFLICT (idempotency_key) DO NOTHING;",
        "options": {
          "queryReplacement": "={{ [$json.l.brand_id, $json.l.phone, $json.comm.content, $json.wamid || '', $json.l.id, $json.l.broker_id, $json.plan.template, $json.comm.latency_ms, $json.error || '', JSON.stringify($json.comm.metadata), $json.plan.trigger] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
