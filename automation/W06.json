        "query": "INSERT INTO public.lead_activities (lead_id, workflow, actor_type, activity_type, payload, occurred_at, idempotency_key)\nSELECT l.id, 'W06', 'system', 'first_touch_blocked', jsonb_build_object('reason', $2::text), now(), 'w06:blocked:' || l.id::text\n  FROM public.leads l WHERE l.id = $1::uuid\nON CONFLICT (idempotency_key) DO NOTHING;",
        "options": {
          "queryReplacement": "={{ [$json.lead_id || ($json.l && $json.l.id) || null, $json.blocked] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true,
