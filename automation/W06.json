    {
      "id": "n11",
      "name": "Claim the one first touch (w06:first:{lead_id})",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Exactly one intro card per lead: whichever event (hold expiry, skip, page booking) inserts this row first sends.\nINSERT INTO public.lead_activities (lead_id, brand_id, broker_id, workflow, actor_type, activity_type, payload, occurred_at, idempotency_key)\nSELECT l.id, l.brand_id, l.broker_id, 'W06', 'system', 'first_touch_claimed', jsonb_build_object('op', $2::text), now(), 'w06:first:' || l.id::text\n  FROM public.leads l\n WHERE l.id = $1::uuid AND l.opted_out_at IS NULL AND l.broker_id IS NOT NULL AND l.first_message_at IS NULL\nON CONFLICT (idempotency_key) DO NOTHING\nRETURNING lead_id;",
        "options": {
          "queryReplacement": "={{ [$json.l.id, $json.ev.op] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "n12",
      "name": "Claimed? -> need W04 slots?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $('Hold for the in-page booking? (w06.holdSeconds)').first().json;\nconst ev = $('Event after hold').isExecuted ? { ...j.ev, op: 'hold' } : j.ev;\nconst claimed = $input.all().some((i) => i.json && i.json.lead_id);\nconst booked = ev.op === 'booking' && j.l.booking;\nconst need_slots = claimed && !booked && j.l.booking_ui !== 'flow';\nreturn [{ json: { ...j, ev, claimed, need_slots, broker_id: j.l.broker_id, limit: 10 } }];"
      }
    },
