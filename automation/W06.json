    {
      "id": "n16",
      "name": "W04 Slots API (list, limit 10)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2640,
        -200
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "smc-w04",
          "cachedResultName": "W04 Slots API"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "notes": "Called with { broker_id, limit: 10 }; waits -> { slots: [{start,end}], fallback? }. Same rules as GET /slots."
    },
    {
      "id": "n17",
      "name": "Plan card (w06.planFirstTouch + toCloudApi)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = require('lv-automation').w06;\nconst LT = require('lv-automation').leadToken;\nconst j = $('Claimed? -> need W04 slots?').first().json;\nconst slots = j.need_slots ? (($input.first().json || {}).slots || []) : [];\nconst now = Date.now();\nconst l = { ...j.l, mobile: j.l.phone };\nconst b = { id: j.l.broker_id, practice_name: j.l.practice_name, fsp_number: j.l.fsp_number, adviser_name: j.l.adviser_name, intro_card_url: j.l.intro_card_url };\nconst ctx = L.ctxFromEvent({ op: j.ev.op, booking: j.l.booking, booking_ui: j.l.booking_ui, slots }, now);\n// The 60-s clock runs from routed_at (CONTRACTS.md W06). hold -> trigger 'hold'; skip / booking -> that event; lead-ad / CTWA -> 'routed'.\nlet plan = L.planFirstTouch(l, b, ctx);\nif (plan && plan.blocked === 'not_enough_slots') {\n  // Fewer than 3 free slots in 14 days: the Flow card still discloses and lets the lead pick any day; W22 is told.\n  plan = { ...L.planFirstTouch(l, b, { ...ctx, bookingUi: 'flow' }), fallback_from: 'not_enough_slots' };\n}\nconst flow_token = plan && plan.template === 'broker_intro_slots_v2' ? LT.mintFlowToken(l.id, 'book', null, { secret: $env.LEAD_TOKEN_SECRET }) : null;\nconst wa = plan ? L.toCloudApi(plan, { to: l.phone, flow_token, lang: 'en' }) : null;\nreturn [{ json: { ...j, plan, wa, flow_token: flow_token ? 'minted' : null, dry: $env.DRY_RUN_SENDS === 'true', planned_at: now } }];"
      }
    },
