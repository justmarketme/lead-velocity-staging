            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ ['list','is_free','graph_token'].includes($json.req.op) ? 'work' : $json.req.op }}",
                    "rightValue": "work",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "work"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ ['list','is_free','graph_token'].includes($json.req.op) ? 'work' : $json.req.op }}",
                    "rightValue": "send_list",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "send_list"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ ['list','is_free','graph_token'].includes($json.req.op) ? 'work' : $json.req.op }}",
                    "rightValue": "reject",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "reject"
            }
          ]
        },
        "options": {
          "fallbackOutput": "none"
        }
      }
    },
    {
      "id": "n11",
      "name": "Log subcall_rejected",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.lead_activities (lead_id, workflow, actor_type, activity_type, payload, occurred_at)\nVALUES (NULLIF($1, '')::uuid, 'W04', 'system', 'subcall_rejected', jsonb_build_object('reason', $2::text), now())\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [$json.req.lead_id || '', $json.req.reason || 'unknown'] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true
    },
