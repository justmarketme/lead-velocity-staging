    {
      "id": "n15",
      "name": "Load broker + holds (sub)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1440,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (SELECT to_jsonb(k) FROM (SELECT b.id, b.brand_id, b.status, b.adviser_name, b.contact_person, b.practice_name, b.firm_name, b.fsp_number, b.adviser_whatsapp, b.whatsapp_number, b.email,\n         b.methods_supported, b.meeting_hours, b.slot_minutes, b.buffer_minutes, b.min_notice_hours, b.horizon_days, b.max_meetings_per_day,\n         b.max_meetings_per_week, b.bookings_paused, b.add_client_as_attendee, b.calendar_provider, b.calendar_status, b.calendar_mode,\n         b.calendar_email, b.ms_tenant_id, b.calendar_status_at, b.calendar_status_detail, b.current_cycle_id FROM public.brokers b WHERE b.id::text = $1 AND b.brand_id IS NOT NULL) k) AS broker,\n       COALESCE((SELECT jsonb_agg(jsonb_build_object('id', a.id, 'start', a.appointment_date, 'end', a.ends_at, 'status', a.status))\n                   FROM public.appointments a\n                  WHERE a.broker_id::text = $1 AND a.brand_id IS NOT NULL\n                    AND a.status IN ('booked','confirmed') AND a.ends_at > now() - interval '1 day'), '[]'::jsonb) AS bookings;",
        "options": {
          "queryReplacement": "={{ [$json.req.broker_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "n16",
      "name": "Merge (sub)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = require('lv-automation').w04;\nconst c = $('Normalise sub-call (w04.subcallInput)').first().json;\nconst r = $input.first().json;\nreturn [{ json: { lane: 'sub', req: c.req, hdr: {}, lead: null, broker: r.broker || null, bookings: r.bookings || [] } }];"
      }
    },
    {
      "id": "n17",
      "name": "Plan (w04.planRequest)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = require('lv-automation').w04;\nconst x = $input.first().json;\nconst now = x.lane === 'sub' ? L.subClockFor(x.req, $env) : L.clockFor(x.hdr || {}, $env, !!(x.lead && x.lead.is_synthetic));\nconst plan = L.planRequest(x);\nconst b = L.brokerConfig(x.broker || {});\nconst gs = plan.next === 'graph' ? L.getScheduleRequest(b, now, { fresh: !!x.req.fresh }) : null;\nconst tk = plan.next === 'graph' ? L.tokenRefreshForm({ clientId: $env.MS_GRAPH_CLIENT_ID, tenant: b.ms_tenant_id || $env.MS_GRAPH_TENANT }) : null;\nconst stale = !b.calendar_status_at || now - Date.parse(b.calendar_status_at) > 86400000;\nreturn [{ json: { ...x, now, plan, gs, tk, stale, token_only: !!plan.token_only, busy: plan.route === 'shared' ? [] : null } }];"
      }
    },
    {
      "id": "n18",
      "name": "Next?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        240,
        400
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.plan.next }}",
                    "rightValue": "respond",
