    {
      "id": "n25",
      "name": "calendar.refresh_failed (+ status)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        0,
        600
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (SELECT CASE WHEN $3 <> '' THEN public.smc_set_calendar_status($1::uuid, $3, jsonb_build_object('reason', $2::text)) END AS st)\nINSERT INTO public.lead_activities (lead_id, brand_id, broker_id, workflow, actor_type, activity_type, payload, occurred_at)\nSELECT NULL, b.brand_id, b.id, 'W04', 'system', 'calendar.refresh_failed', jsonb_build_object('reason', $2::text, 'transient', $4::boolean), now()\n  FROM public.brokers b, s WHERE b.id = $1::uuid\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [$json.broker.id, $json.tok.reason || 'unknown', $json.tok.status_to || '', !!$json.tok.transient] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true
    },
    {
