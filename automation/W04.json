      "typeVersion": 2,
      "position": [
        240,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = require('lv-automation').w04;\nconst x = $('Token plan (w04.planToken)').first().json;\nreturn [{ json: { ...x, busy: null } }];"
      }
    },
    {
      "id": "n27",
      "name": "Vault: keep rotated refresh token (daily)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        600
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- ASSUMPTION: Microsoft rotates refresh tokens and the previous one stays valid; store the new one at most once a day.\nSELECT CASE WHEN $2 <> '' AND $3::boolean THEN public.smc_vault_store_ms_refresh($1::uuid, $2, NULL, NULL) END AS stored;",
        "options": {
          "queryReplacement": "={{ [$json.broker.id, ($('Microsoft token refresh').first().json.body || {}).refresh_token || '', !!$json.stale] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true
    },
