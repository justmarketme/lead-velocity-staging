      "typeVersion": 2,
      "position": [
        480,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = require('lv-automation').w04;\nconst x = $input.first().json;\nconst hit = !x.token_only && !x.req.fresh ? L.cacheGet($getWorkflowStaticData('global').w04_busy, L.brokerConfig(x.broker).broker_id, x.now) : null;\nreturn [{ json: { ...x, busy: hit, cached: !!hit } }];"
      }
    },
