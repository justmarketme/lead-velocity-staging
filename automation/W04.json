      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = require('lv-automation').w04;\nconst x = $('Token plan (w04.planToken)').first().json;\nconst busy = L.parseGetSchedule($input.first().json);\nconst sd = $getWorkflowStaticData('global'); sd.w04_busy = sd.w04_busy || {};\nif (busy) L.cachePut(sd.w04_busy, L.brokerConfig(x.broker).broker_id, busy, x.now);\nconst { tok, ...rest } = x;\nreturn [{ json: { ...rest, busy } }];"
      }
    },
    {
      "id": "n31",
      "name": "Compute (w04.respond)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = require('lv-automation').w04;\nconst HOL = new Set(require('lv-automation').holidays.holidays.map((h) => h.date));\nlet x = $input.first().json;\nif (!x.plan) x = $('Token plan (w04.planToken)').first().json;\nlet out;\nif (x.plan.next === 'respond') out = x.plan.result;\nelse if (x.token_only) out = x.tok && x.tok.ok ? { access_token: x.tok.access_token, expires_at: x.tok.expires_at } : { error: 'refresh_failed' };\nelse out = L.respond({ lane: x.lane, req: x.req, broker: x.broker, bookings: x.bookings, busy: x.busy, route: x.plan.route, now: x.now, holidays: HOL });\nreturn [{ json: x.lane === 'http' ? { lane: 'http', status: out.status, body: out.body } : { lane: 'sub', body: out } }];"
      }
    },
