                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.plan.next }}",
                    "rightValue": "compute",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "compute"
            }
          ]
        },
        "options": {
          "fallbackOutput": "none"
        }
      }
    },
