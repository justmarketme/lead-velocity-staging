        "jsCode": "const L = require('lv-automation').w04;\nreturn $input.all().map((it) => ({ json: { lane: 'sub', req: L.subcallInput(it.json || {}), raw_delegate: (it.json && it.json.delegate) || null } }));"
      }
    },
    {
