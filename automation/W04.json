                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n21",
      "name": "Vault: Microsoft refresh token",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        960,
        400
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Returns the refresh token only while brokers.calendar_status = 'ok' (migration 13). Never logged: this workflow does not save successful executions.\nSELECT public.smc_vault_ms_refresh($1::uuid) AS rt;",
        "options": {
          "queryReplacement": "={{ [$json.plan && $json.broker ? $json.broker.id : null] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "n22",
      "name": "Microsoft token refresh",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Plan (w04.planRequest)').first().json.tk.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "client_id",
              "value": "={{ $env.MS_GRAPH_CLIENT_ID }}"
            },
            {
              "name": "grant_type",
              "value": "refresh_token"
            },
            {
              "name": "refresh_token",
              "value": "={{ $json.rt || \"\" }}"
            },
            {
              "name": "scope",
              "value": "offline_access User.Read Calendars.ReadWrite OnlineMeetings.ReadWrite"
            }
          ]
        },
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "",
          "name": "Microsoft Graph broker-connect client secret (W20)"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "n23",
      "name": "Token plan (w04.planToken)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = require('lv-automation').w04;\nconst x = $('Plan (w04.planRequest)').first().json;\nconst tok = L.planToken($input.first().json, x.now);\nreturn [{ json: { ...x, tok } }];"
      }
    },
