    {
      "id": "n33",
      "name": "broker_fit_followup template",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        800
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const L = require('lv-automation').w29;\nconst r = $('fit_followup due').item.json; if (!$json.id) return { json: { skip: true } };\n// RETIRED 2026-10-06 (agreement clause 8.4): w29.followupDue is always false, so broker_fit_followup is never sent.\nif (!L.followupDue(r, Date.now(), false)) return { json: { skip: true } };\nconst d = new Date(Date.parse(r.marked_at) + 7200000); const lbl = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][d.getUTCDay()] + ' ' + d.getUTCDate() + ' ' + ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getUTCMonth()];\nconst who = (r.first_name || '') + (r.last_name ? ' ' + r.last_name.slice(0, 1) + '.' : '');\nreturn { json: { skip: false, wa: { messaging_product: 'whatsapp', to: r.whatsapp_number, type: 'template', template: { name: 'broker_fit_followup', language: { code: 'en' }, components: [{ type: 'body', parameters: [String(r.contact_person).split(' ')[0], lbl, who].map((t) => ({ type: 'text', text: t })) }, { type: 'button', sub_type: 'quick_reply', index: '0', parameters: [{ type: 'payload', payload: 'fit_followup:' + r.lead_id + ':done' }] }, { type: 'button', sub_type: 'quick_reply', index: '1', parameters: [{ type: 'payload', payload: 'fit_followup:' + r.lead_id + ':open' }] }, { type: 'button', sub_type: 'url', index: '2', parameters: [{ type: 'text', text: 'leads/' + r.lead_id }] }] } } } };"
      }
    },
    {
      "id": "n34",
      "name": "W13 claim item (op, outcome_id, reason, reason_code, idempotency_key)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        360
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// I-45k: W13 contract { op, outcome_id, reason, reason_code, idempotency_key } (CONTRACTS 'Sub-workflow interfaces').\nconst L = require('lv-automation').w29;\nconst out = [];\n$input.all().forEach((it, i) => {\n  const a = $('Apply disposition').itemMatching(i).json;\n  const call = L.w13Call(a.o, a.d);\n  if (call) out.push({ json: call });\n});\nreturn out;"
      }
    }
