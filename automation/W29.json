      "id": "n32",
      "name": "Claim follow-up nudge",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1540,
        600
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.lead_activities (lead_id, brand_id, broker_id, workflow, actor_type, activity_type, payload, occurred_at, idempotency_key)\nVALUES ($1::uuid, $2::uuid, $3::uuid, 'W29', 'system', 'fit_followup_sent', '{}'::jsonb, now(), 'w29:followup_sent:' || $4)\nON CONFLICT (idempotency_key) DO NOTHING\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [$json.lead_id, $json.brand_id, $json.broker_id, $json.id] }}"
        }
