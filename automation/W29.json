      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT o.id, o.lead_id, o.broker_id, o.brand_id, o.marked_at, o.disposition_code, l.first_name, l.last_name, b.contact_person, b.whatsapp_number\n  FROM public.outcomes o\n  JOIN public.leads l ON l.id = o.lead_id\n  JOIN public.brokers b ON b.id = o.broker_id\n WHERE o.brand_id IS NOT NULL AND o.disposition_code = 'fit_followup'\n   AND o.marked_at <= now() - interval '7 days' AND o.marked_at > now() - interval '30 days'\n   AND NOT EXISTS (SELECT 1 FROM public.lead_activities x WHERE x.idempotency_key = 'w29:followup_sent:' || o.id);",
        "options": {
          "queryReplacement": "={{ [] }}"
        }
