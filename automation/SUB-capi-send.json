    {
      "name": "Load lead, consent, dataset and dedupe",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "credentials": {
        "postgres": {
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (l.id IS NOT NULL) AS found, l.consent_ads_at, l.phone, l.first_name, l.last_name, l.fbc, l.fbp, l.client_ip, l.client_user_agent,\n       COALESCE(NULLIF($2, '')::uuid, l.brand_id)::text AS lead_brand_id, br.pixel_id, br.dataset_id, br.waba_id,\n       EXISTS (SELECT 1 FROM public.capi_log g WHERE g.event_id = $3 AND g.event_name = $4) AS duplicate\n  FROM (SELECT 1) one\n  LEFT JOIN public.leads l ON l.id = NULLIF($1, '')::uuid\n  LEFT JOIN public.brands br ON br.id = COALESCE(NULLIF($2, '')::uuid, l.brand_id);",
        "options": {
          "queryReplacement": "={{ [ $json.lead_id || '', $json.brand_id || '', $json.event_id, $json.event_name ] }}"
        }
      },
      "id": "smc-capi-send-4",
      "position": [
        880,
        300
      ]
    },
    {
      "name": "Build event (consent gate, no email, dry run)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Consent gate first (capi/event-spec.md). Email is never sent. DRY_RUN_SENDS: nothing is written or posted.\nconst L = require('lv-automation').subCapiSend;\nconst n = $('Normalise input').item.json;\nreturn { json: L.build(n, $json, $env, Date.now()) };"
      },
      "id": "smc-capi-send-5",
      "position": [
        1100,
        340
      ]
    },
    {
      "name": "Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.action === 'send' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "smc-capi-send-6",
      "position": [
        1320,
        380
      ]
    },
    {
      "name": "Claim capi_log (unique event_id + event_name)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "credentials": {
        "postgres": {
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.capi_log (lead_id, brand_id, event_name, event_id, action_source, status)\nVALUES (NULLIF($1, '')::uuid, NULLIF($2, '')::uuid, $3, $4, $5, 'sending')\nON CONFLICT (event_id, event_name) DO NOTHING\nRETURNING id::text AS log_id;",
        "options": {
          "queryReplacement": "={{ [ $json.log.lead_id || '', $json.log.brand_id || '', $json.log.event_name, $json.log.event_id, $json.log.action_source ] }}"
        }
      },
      "id": "smc-capi-send-7",
      "position": [
        1540,
        300
      ]
    },
