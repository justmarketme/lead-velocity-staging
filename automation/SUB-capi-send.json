      "onError": "continueRegularOutput",
      "parameters": {
        "operation": "write",
        "fileName": "={{ $env.CAPI_EVIDENCE_PATH || '/data/evidence/capi-test-events.jsonl' }}",
        "dataPropertyName": "data",
        "options": {
          "append": true
        }
      },
