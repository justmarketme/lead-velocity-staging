# automation/.env.example — names only. Copy the names into the repo-root .env (git-ignored) and fill values there.
# Never commit values. Every variable used by W01–W35, the Flow endpoint and submit.sh is listed here.

# ---------- Runtime / n8n ----------
NODE_ENV=                         # development | staging | production
TZ=                               # Africa/Johannesburg (all slot maths and schedules)
N8N_PUBLIC_URL=                   # public HTTPS base of n8n (tunnel URL before VPS, then n8n.<domain>); webhooks register against this
WEBHOOK_URL=                      # n8n's own webhook base setting (same value as N8N_PUBLIC_URL)
N8N_HOST=                         # n8n host name
N8N_PORT=                         # n8n internal port (5678)
N8N_PROTOCOL=                     # https
N8N_ENCRYPTION_KEY=               # n8n credential encryption key (backed up off-box; W26 restores it)
N8N_BASIC_AUTH_USER=              # editor login user (or SSO later)
N8N_BASIC_AUTH_PASSWORD=          # editor login password
N8N_API_KEY=                      # n8n public API key (CI import/export of workflow JSON)
NODE_FUNCTION_ALLOW_BUILTIN=      # leave unset: fixed to crypto,dns,url,fs,path in automation/docker-compose.yml + the VPS overlay (I-35b/I-36e); compose wins over .env
NODE_FUNCTION_ALLOW_EXTERNAL=     # leave unset: fixed to lv-automation in both compose files (I-46d). That one name is this repo's automation/index.cjs, linked by the compose entrypoint; Code nodes use require('lv-automation').<name> only, no npm packages
GENERIC_TIMEZONE=                 # Africa/Johannesburg (n8n schedule triggers)
EXECUTIONS_DATA_PRUNE=            # true (keep execution logs bounded; PII redaction applies)
EXECUTIONS_DATA_MAX_AGE=          # hours to keep execution data
TUNNEL_TOKEN=                     # Cloudflare Tunnel token for local n8n before the VPS exists (0.3 #7)

# ---------- Database (n8n state + Lead Velocity CRM) ----------
DB_POSTGRESDB_HOST=               # Postgres host for n8n
DB_POSTGRESDB_PORT=               # Postgres port
DB_POSTGRESDB_DATABASE=           # n8n database name
DB_POSTGRESDB_USER=               # n8n database user
DB_POSTGRESDB_PASSWORD=           # n8n database password
SUPABASE_URL=                     # existing Lead Velocity Supabase project URL (CRM tables: leads, bookings, outcomes…)
SUPABASE_SERVICE_ROLE_KEY=        # server-side key for n8n writes (never shipped to a browser)
SUPABASE_ANON_KEY=                # public anon key (page/portal reads under RLS)
SUPABASE_DB_URL=                  # direct Postgres connection string for the facts schema / transactions in W05

# ---------- Brand ----------
BRAND_ID=                         # uuid: brands.id of the active consumer brand (SortMyCover); W01 casts it to uuid — never the slug (rehearsal F1)
CONSUMER_DOMAIN=                  # sortmycover.co.za (.ics links /c/, join redirects /j/)
PORTAL_URL=                       # broker portal base URL (deep links in broker templates)
CONSOLE_URL=                      # ops console base URL (deep links in ops templates)
OPS_WHATSAPP_JONATHAN=            # E.164 for ops_* templates and Red alerts
OPS_WHATSAPP_KG=                  # E.164 for ops_* templates and Red alerts
OPS_EMAIL=                        # howzit@leadvelocity.co.za (email copies of Red/weekly)

# ---------- Meta: WhatsApp Cloud API ----------
META_GRAPH_VERSION=               # Graph API version string used in every call (e.g. v23.0; pinned, bumped deliberately)
META_APP_ID=                      # Meta app id (resumable uploads for template header samples, webhooks)
META_APP_SECRET=                  # app secret: verifies X-Hub-Signature-256 on every webhook (WhatsApp, Lead Ads, feed, Flow)
META_SYSTEM_USER_TOKEN=           # non-expiring system-user token (WABA, templates, Marketing API, CAPI)
META_WEBHOOK_VERIFY_TOKEN=        # hub.verify_token for webhook subscription handshake
META_BUSINESS_ID=                 # business portfolio id
WABA_ID=                          # WhatsApp Business Account id (template submission, quality rating)
PHONE_NUMBER_ID=                  # sending phone number id (messages, Flow encryption key registration)
STANDBY_PHONE_NUMBER_ID=          # warm standby number on the same WABA (quality-rating failover)
WHATSAPP_TEST_PHONE_NUMBER_ID=    # Meta test number used for staging before the WABA display name is approved
WHATSAPP_TEST_RECIPIENTS=         # comma-separated E.164 allow-list for staging sends (synthetic tests only)

# ---------- Meta: WhatsApp Flows (W28) ----------
BOOKING_FLOW_ID=                  # published booking Flow id (broker_intro_slots_v2 FLOW button)
RESCHEDULE_FLOW_ID=               # published reschedule Flow id (reschedule_offer_v2 FLOW button)
FLOW_ENDPOINT_URL=                # HTTPS URL of the Flow data_exchange endpoint (behind Traefik)
FLOW_PRIVATE_KEY=                 # RSA-2048 private key PEM (decrypts Flow requests); single line with \n escapes
FLOW_PRIVATE_KEY_PASSPHRASE=      # passphrase for FLOW_PRIVATE_KEY, if set
FLOW_PUBLIC_KEY=                  # matching public key PEM registered via /{PHONE_NUMBER_ID}/whatsapp_business_encryption

# ---------- Meta: Pages, Lead Ads, Ads, CAPI ----------
PAGE_ID=                          # SortMyCover Facebook Page id (Lead Ads, comments, Messenger)
PAGE_ACCESS_TOKEN=                # page token for comment replies / private replies / Messenger (W30, W31)
IG_USER_ID=                       # Instagram professional account id (IG comments + DMs)
AD_ACCOUNT_ID=                    # act_… primary ad account (W21 insights, budget changes via console)
STANDBY_AD_ACCOUNT_ID=            # standby ad account in the same portfolio
PIXEL_ID=                         # Meta Pixel / dataset id for web CAPI events (Lead, Schedule)
DATASET_ID=                       # dataset id for business-messaging CAPI (CTWA Lead/Schedule) and offline Attended
CAPI_TEST_EVENT_CODE=             # test_event_code for staging (removed in production)

# ---------- Microsoft Graph / Entra ID (Outlook calendar, Teams, howzit@ mailbox) ----------
MS_TENANT_ID=                     # Lead Velocity M365 tenant id
MS_GRAPH_CLIENT_ID=               # Entra app registration (client) id — one app for brokers + howzit@ (W20 ms/connect + ms/callback)
MS_CLIENT_SECRET=                 # Entra app client secret (rotated; expiry tracked by W22)
MS_GRAPH_REDIRECT_URI=            # must equal {N8N_PUBLIC_URL}/webhook/ms/callback and the redirect URI on the Entra app
MS_GRAPH_TENANT=                  # Entra tenant for the authorize/token endpoints; default organizations (any work tenant)
MS_OAUTH_STATE_SECRET=            # optional: HMAC key for the 10-minute OAuth state token (falls back to INTERNAL_HMAC_SECRET)
MS_OAUTH_STATE_SECRET_PREVIOUS=   # optional: previous state key accepted during rotation
MS_ADMIN_CONSENT_REDIRECT_URI=    # optional: where Microsoft returns after admin consent (falls back to PORTAL_URL)
MS_SCOPES=                        # informational: W20 fixes the broker scopes in automation/lib/w20-ms.mjs (openid offline_access User.Read Calendars.ReadWrite OnlineMeetings.ReadWrite — no Mail.*, per portal spec 05 Part A)
MS_ADMIN_CONSENT_URL=             # admin-consent link shown in the portal when a broker tenant blocks app consent (0.3 #4)
HOWZIT_MAILBOX=                   # howzit@leadvelocity.co.za (sends invites, receives NDRs, W17 inContact parsing)
MS_GRAPH_SUBSCRIPTION_SECRET=     # clientState for Graph change-notification subscriptions (bounces, mail)
SHARED_FALLBACK_CALENDAR_ID=      # shared calendar used when a broker tenant blocks consent (0.3 #4 fallback)
TOKEN_ENC_KEY=                    # key used to encrypt broker OAuth refresh tokens at rest

# ---------- Google (optional, Google-Workspace brokers only) ----------
GOOGLE_CLIENT_ID=                 # OAuth client for Google Calendar + Meet (published "In production")
GOOGLE_CLIENT_SECRET=             # OAuth client secret
GOOGLE_REDIRECT_URI=              # OAuth redirect for "Connect Google Calendar"

# ---------- Zoom (optional, per broker) ----------
ZOOM_CLIENT_ID=                   # Zoom Marketplace OAuth app id
ZOOM_CLIENT_SECRET=               # Zoom Marketplace OAuth app secret
ZOOM_REDIRECT_URI=                # OAuth redirect for "Connect Zoom"
ZOOM_WEBHOOK_SECRET=              # Zoom event webhook verification secret

# ---------- Twilio (Lookup, SMS fallback, Red-alert voice) ----------
TWILIO_ACCOUNT_SID=               # Twilio account SID
TWILIO_API_KEY_SID=               # Twilio API key SID (preferred over auth token)
TWILIO_API_KEY_SECRET=            # Twilio API key secret
TWILIO_LOOKUP_ENABLED=            # true | false — line-type check at W01/W07 (rejects landline/VoIP)
TWILIO_SMS_FROM=                  # sender id / number for undeliverable-WhatsApp SMS fallback (W06)
TWILIO_VOICE_FROM=                # number for the 4-h unacknowledged Red alert call (only voice use, 6.8b)

# ---------- Email validation (W05 / Flow) ----------
EMAIL_PROBE_ENABLED=              # false by default; ZeroBounce-class probe only if bounce rate > 5%
EMAIL_PROBE_API_KEY=              # probe provider key (unused while disabled)

# ---------- Anthropic (conversation agent, briefs, judge) ----------
ANTHROPIC_API_KEY=                # Claude API key (W07, W11 briefs, W30/W31, W32, W33)
ANTHROPIC_BASE_URL=               # leave unset in production (https://api.anthropic.com); the local smoke points it at the egress stub (RUN-LOCAL-NO-DOCKER.md 6)
ANTHROPIC_MODEL_FAST=             # Haiku-class model id for intent/reply/guardrail turns (4A)
ANTHROPIC_MODEL_STRONG=           # stronger model id for ambiguous/sensitive turns and the judge (4A)
TRANSCRIBE_API_KEY=               # speech-to-text key for broker voice notes (W12) and intro media captions (W23)

# ---------- Payments (W16, W19, W25) ----------
PAYSTACK_SECRET_KEY=              # Paystack secret key (Instant EFT/card, plans)
PAYSTACK_PUBLIC_KEY=              # Paystack public key (checkout)
PAYSTACK_WEBHOOK_SECRET=          # signature verification for Paystack webhooks (HMAC uses secret key if not separate)
OZOW_SITE_CODE=                   # Ozow site code (Instant EFT alternative)
OZOW_PRIVATE_KEY=                 # Ozow hash key
OZOW_API_KEY=                     # Ozow API key
FNB_INCONTACT_SENDER=             # sender address filter for FNB inContact emails parsed by W17
BANK_ACCOUNT_REF_PREFIX=          # prefix for unique manual-EFT references (e.g. SMC-)

# ---------- Hosting / deploy (W26) ----------
VPS_HOST=                         # VPS IP/host (set by W26 after first payment)
VPS_SSH_USER=                     # deploy user
VPS_SSH_KEY_PATH=                 # path to deploy key on the operator machine (key itself never in repo)
TRAEFIK_ACME_EMAIL=               # Let's Encrypt contact for Traefik certificates
BACKUP_S3_ENDPOINT=               # off-box backup target endpoint
BACKUP_S3_BUCKET=                 # backup bucket
BACKUP_S3_ACCESS_KEY=             # backup access key
BACKUP_S3_SECRET_KEY=             # backup secret key

# ---------- Security / abuse (6B.5) ----------
TURNSTILE_SECRET_KEY=             # Cloudflare Turnstile server secret for /lead and /book
RATE_LIMIT_PER_IP_PER_HOUR=       # submissions per IP per hour on /lead and /book
INTERNAL_HMAC_SECRET=             # server-to-server only (portal/edge functions -> n8n, W20 events, W22 alerts); NEVER in a browser: /lead /slots /book use Turnstile + lead token + rate limits (I-11, automation/W03-notes.md B)
LOG_REDACTION=                    # true — redact numbers/emails in logs (0.3 #10)

# ---------- Feature flags ----------
BOOKING_UI_DEFAULT=               # list | flow — default for brands.booking_ui (list until the Flow is published)
VOICE_FALLBACK_ENABLED=           # false — optional voice step for unbooked leads after 24 h (W08), off by default
DRY_RUN_SENDS=                    # true in staging: messages to non-allow-listed numbers are logged, not sent

# ---------- Added by devops-security (automation/security/SECURITY.md) ----------
TWILIO_AUTH_TOKEN=                # Twilio account Auth Token: ONLY to verify X-Twilio-Signature on inbound callbacks (API key stays for outbound)
N8N_BLOCK_ENV_ACCESS_IN_NODE=     # false — lets Code nodes read $env (webhook secrets, ops numbers); editor access = secret access, so the UI is IP-restricted + MFA
N8N_DIAGNOSTICS_ENABLED=          # false — no telemetry from a box that holds consumer data
N8N_LOG_LEVEL=                    # warn in production (info in staging); never debug with live data (debug logs request bodies)
EXECUTIONS_DATA_SAVE_ON_SUCCESS=  # none — successful executions are not stored (PII minimisation); errors are kept, then pruned
EXECUTIONS_DATA_PRUNE_MAX_COUNT=  # hard cap on stored executions (e.g. 5000)
N8N_UI_HOST=                      # n8n.leadvelocity.co.za (editor; Traefik IP allow-list)
N8N_UI_ALLOW_IPS=                 # comma-separated CIDRs allowed to reach the editor; empty = editor only via SSH tunnel
API_HOST=                         # api.leadvelocity.co.za (webhooks + /healthz only)
LINK_HOST=                        # link.sortmycover.co.za (consumer /c/ .ics and /j/ join redirects, set at W26)
BACKUP_AGE_RECIPIENT=             # age public key (age1…) that backups are encrypted to; the private key is NEVER on the VPS
BACKUP_GPG_RECIPIENT=             # fallback only if age is unavailable: gpg key id/fingerprint (public key imported on the VPS)
BACKUP_DB_URL=                    # Postgres URL of the backup_reader role on Supabase (read-only; separate from SUPABASE_DB_URL)
BACKUP_S3_REGION=                 # region string for SigV4 (e.g. auto for R2, or the B2/S3 region)
BACKUP_LOCAL_DIR=                 # local staging dir for dumps on the VPS (default /var/backups/lv)
OPS_FEEDER_DB_URL=                # Postgres URL of the n8n_app role for the nightly ops feeders (I-22); unset = feeders skipped
OPS_MONITORS=                     # space-separated monitor labels that always get an ops.infra_day row (default "api")
OPS_PAGE_REPORT_DIR=              # where Lighthouse *.report.json files are dropped for ops.page_day/page_audits (default <repo>/landing/reports)
OPS_PAGE_BRAND_CODE=              # brands.code the page rows belong to (default SMC)
OPS_BUILD_SHA=                    # git sha of the landing build being audited (optional)
OPS_PING_URL=                     # optional dead-man ping URL hit after every good backup (uptime monitor heartbeat)

# ---------- Added by automation-engineer, integration pass 2 (I-05 + every $env./process.env name found in automation/) ----------
# Onboarding (W20)
FSCA_REGISTER_URL=                # FSCA register lookup endpoint W20 calls with ?fsp=<number>; mechanism unconfirmed offline (NH-BS-09)
FSCA_LIFE_CATEGORY_PATTERN=       # regex the register's category list must match to count as "authorised for life" (default long.?term|life; ASSUMPTION)
SLOTS_API_URL=                    # internal W04 GET /slots URL W20 calls to prove a connected calendar returns at least 1 slot
COMPLIANCE_PREFLIGHT_URL=         # compliance-qa pre-flight runner W20 calls once a broker is onboarded (callback = /webhook/w20/preflight-result)
GO_LIVE_HANDOFF_URL=              # W26/W16 go-live hand-off endpoint W20 calls after Jonathan taps Approve & go live
# Intro media (W23)
TRANSCRIBE_URL=                   # self-hosted faster-whisper HTTP endpoint (captions + broker voice notes); nothing leaves the VPS
WHISPER_MODEL=                    # whisper model name passed to TRANSCRIBE_URL (e.g. small / medium)
ANTHROPIC_MODEL_CHECK=            # cheap Anthropic model id for the W23 thumbnail/likeness check (4A routing)
INTRO_PUBLIC_BASE=                # public HTTPS base for approved intro media (default https://media.sortmycover.co.za)
INTRO_RAW_BUCKET=                 # storage bucket for raw broker uploads (default intro-raw; private, purged after processing)
INTRO_MEDIA_BUCKET=               # storage bucket for processed, approved intro media (default intro-media)
OPS_ALERT_WEBHOOK=                # UNUSED since I-47g: W23 alerts go to W22 by Execute Workflow smc-w22; leave empty
WA_PHONE_NUMBER_ID=               # ALIAS of PHONE_NUMBER_ID used by W23 + test harness; set to the same value until the names are unified (needs_human)
# Community + DMs (W30, W31)
CTWA_BASE_URL=                    # tracked CTWA redirect base on the consumer domain, e.g. https://sortmycover.co.za/wa (link = CTWA_BASE_URL/cmt_{ad_id}); see automation/W03-notes.md
COMMENT_HASH_SALT=                # salt for hashing commenter ids in the comments table (rotate = old hashes stop matching)
META_VERIFY_TOKEN=                # ALIAS of META_WEBHOOK_VERIFY_TOKEN used by W30/W31; same value until unified (needs_human)
N8N_INTERNAL_URL=                 # n8n base URL on the docker network (http://n8n:5678) (UNUSED since I-47g: alerts go to W22 by Execute Workflow smc-w22)
AUTOMATION_DIR=                   # leave unset: compose fixes it to /repo/automation (inside the read-only repo mount; also the lv-automation link target)
REPO_DIR=                         # leave unset: compose mounts the repo root read-only at /repo and sets REPO_DIR=/repo (guardrail.mjs, automation/lib, W25 price diff, W30/W31 corpus)
ANALYTICS_DB_URL=                 # laptop only: Postgres URL of a DDL-capable owner of schema facts; W26 step 12 apply-analytics.sh (I-35k). Stripped from the VPS .env
# Meta Ads / CAPI (ads-api-engineer, attribution-analyst modules)
META_API_VERSION=                 # ALIAS of META_GRAPH_VERSION read by capi.js / meta-ads.js / W02 / W21 / W27 (default v23.0); same value until unified
API_VERSION=                      # legacy fallback name read by capi.js only; leave empty
META_TEST_EVENT_CODE=             # ALIAS of CAPI_TEST_EVENT_CODE read by capi.js; staging only, empty in production
META_MIN_DAILY_BUDGET_ZAR=        # floor for any ad-set daily budget the code will set (default 20; ASSUMPTION, verify on a test object)
META_CONFIRM_SECRET=              # >= 16 chars; HMAC key for one-time confirm tokens on budget/status changes (meta-ads.js)
# Compliance cleanse (W24)
NCC_REGISTRY_MODE=                # csv (default, working path) | api (only once the NCC mechanism is recorded at GATE-NCC)
NCC_REGISTRY_ENDPOINT=            # NCC registry API URL; empty = csv mode (NH-CQ-W24-1)
NCC_REGISTRY_BATCH_SIZE=          # numbers per registry API call (default 1000)
W24_INCLUDE_LEGACY=               # false (default) | true = also cleanse legacy B2B leads with brand_id null (NH-14; compliance-qa recommends true)
W24_TEST_MODE=                    # true = run on is_synthetic leads only (staging tests)
W24_EVIDENCE_DIR=                 # container path for monthly evidence (default /home/node/compliance/evidence; git-ignored, private)
W24_INBOX_DIR=                    # container path for the NCC registry CSV drop (default /home/node/compliance/inbox; file deleted after each run)
# Billing (W16-W19, W25)
BILLING_API_BASE=                 # public base of the billing endpoints the static checkout posts to
BILLING_STATEMENT_INBOX=          # container path W18 reads CSV/OFX statements from (default /home/node/billing/statements/inbox)
FNB_SENDER_ADDRESSES=             # comma-separated FNB inContact sender addresses W17 trusts (GATE-INCONTACT)
FNB_SENDER_DOMAINS=               # comma-separated FNB sender domains W17 trusts (DMARC-checked)
BANK_NAME=                        # manual-EFT details printed on invoices/checkout (public by design, still kept out of the repo)
BANK_ACCOUNT_NAME=                # manual-EFT account name
BANK_ACCOUNT_NUMBER=              # manual-EFT account number
BANK_ACCOUNT_TYPE=                # manual-EFT account type
BANK_BRANCH_CODE=                 # manual-EFT branch code
PAYSTACK_ENABLED=                 # false until Paystack KYC clears (0.3 #5); true switches on Instant EFT/card + plan sync
W25_TARGET=                       # staging (default) | production — where W25 deploys the pricing page
W25_OUT_DIR=                      # container path W25 renders the site into (default /home/node/billing/site)
W25_REMOTE_ROOT=                  # Hostinger path for the production pricing page
W25_REMOTE_STAGING_ROOT=          # Hostinger path for the staging pricing page
PRICE_DIFF_ROOT=                  # optional root for billing/price-diff.mjs (defaults to the repo root)
# Public endpoint protection for /lead /slots /book (I-11; design in automation/W03-notes.md section B)
TURNSTILE_SITE_KEY=               # Cloudflare Turnstile site key (public; baked into the landing page build)
RATE_LIMIT_PER_NUMBER_PER_DAY=    # max /lead + /book attempts per mobile hash per 24 h (default 5)
RATE_LIMIT_SLOTS_PER_IP_PER_MIN=  # max GET /slots per IP per minute (default 30)
TURNSTILE_FAIL_MODE=              # open (default for /lead: store with bot_check=unverified, tighter limits) | closed; /book always fails closed
RATE_LIMIT_IP_SALT=               # random string; W01 counts /lead per IP as an HMAC of the IP with this salt (the raw IP is never stored in the counter)
W15_STOP_BOOKING_MODE=cancel      # cancel (default: STOP releases the booking and deletes the Outlook event) | keep (booking stays, messages stop); NH-28 b
# PUBLIC_ALLOWED_ORIGINS (I-34c, I-37i): comma-separated Origins for CORS on API_HOST /lead /slots /book /billing-autorenew (Traefik api-cors).
#   Production (VPS, from W26; also the overlay default when unset): https://sortmycover.co.za,https://www.sortmycover.co.za,https://app.leadvelocity.co.za
#   Staging (laptop/tunnel; webhook-node Allowed Origins): https://sortmycover.co.za,https://www.sortmycover.co.za,https://sortmycover.leadvelocity.co.za,https://app.leadvelocity.co.za
#   The staging subdomain is never allowed on production (0.1: staging is never shown to consumers or Meta). Never "*".
PUBLIC_ALLOWED_ORIGINS=
LEAD_TOKEN_TTL_HOURS=             # lead_token lifetime; contract fixes 336 (14 days), see automation/CONTRACTS.md "lead_token" (verify refuses anything longer)
LEAD_TOKEN_SECRET=                # >= 32 random chars; HMAC-SHA256 key for lead_token (X-Lead-Token) and W28 flow_token. Server-side only, never in the page
LEAD_TOKEN_SECRET_PREVIOUS=       # previous LEAD_TOKEN_SECRET during a rotation (verify-only; clear after 14 days)
SUPABASE_JWT_SECRET=              # Supabase project JWT secret (HS256) used by GET /slots broker path (Authorization: Bearer <access token>)
WA_DISPLAY_NUMBER_DIGITS=         # brand WhatsApp number as digits (27...) for the W03 CTWA redirect Location; also cached from the brands row
# Test harness only (never set in production)
N8N_WEBHOOK_PREFIX=               # webhook path prefix the acceptance tests call (default /webhook)
TEST_HOOKS_ENABLED=               # true only on staging: enables /test/* hooks + X-Test-Now virtual clock
TEST_HOOKS_TOKEN=                 # shared token the tests send as X-Test-Token
SMC_TEST_OFFLINE=                 # 1 = force the acceptance tests offline even when N8N_PUBLIC_URL is set
ESC_REAL_KINDS=
BROKER_WA_NUMBERS=
W34_NONFIT_RETENTION_HOURS=
W34_LEAD_RETENTION_MONTHS=
W34_CONSENT_RETENTION_YEARS=
W34_DSR_RECORD_YEARS=
W34_MEDIA_ERASE_URL=              # <SUPABASE_URL>/functions/v1/w34-media-erase (edge function, HMAC W34_MEDIA_ERASE_SECRET). See automation/local/LOCAL-STAGING.md 1d
W34_IO_RECIPIENT=                 # Information Officer for W22 dsar_* alerts: jonathan | kg (default jonathan)
W34_EXPORT_DIR=                   # where W34 writes DSR exports inside the n8n container (default /home/node/compliance/dsr-exports); the nightly backup deletes files older than 7 days
W34_UNFINISHED_RETENTION_HOURS=
W34_MEDIA_ERASE_SECRET=           # >= 32 random chars; HMAC key shared by W34 (n8n) and the edge function w34-media-erase (set there by provision.sh step 13)
SUPABASE_PROJECT_REF=             # laptop only: project ref for the Supabase CLI (provision.sh step 13)
SUPABASE_ACCESS_TOKEN=            # laptop only: Supabase CLI personal access token; stripped from the VPS .env
W10_C1A_MODE=
