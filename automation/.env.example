# automation/.env.example — names only. Copy the names into the repo-root .env (git-ignored) and fill values there.
# Never commit values. Every variable used by W01–W35, the Flow endpoint and submit.sh is listed here.

# ---------- Runtime / n8n ----------
NODE_ENV=                         # development | staging | production
TZ=                               # Africa/Johannesburg (all slot maths and schedules)
N8N_PUBLIC_URL=                   # public HTTPS base of n8n (tunnel URL before VPS, then n8n.<domain>); webhooks register against this
WEBHOOK_URL=                      # n8n's own webhook base setting (same value as N8N_PUBLIC_URL)
N8N_HOST=                         # n8n host name
N8N_PORT=                         # n8n internal port (5678)
N8N_PROTOCOL=                     # https
N8N_ENCRYPTION_KEY=               # n8n credential encryption key (backed up off-box; W26 restores it)
N8N_BASIC_AUTH_USER=              # editor login user (or SSO later)
N8N_BASIC_AUTH_PASSWORD=          # editor login password
N8N_API_KEY=                      # n8n public API key (CI import/export of workflow JSON)
NODE_FUNCTION_ALLOW_BUILTIN=      # crypto (Flow endpoint in a Code node; DNS MX lookups use dns)
GENERIC_TIMEZONE=                 # Africa/Johannesburg (n8n schedule triggers)
EXECUTIONS_DATA_PRUNE=            # true (keep execution logs bounded; PII redaction applies)
EXECUTIONS_DATA_MAX_AGE=          # hours to keep execution data
TUNNEL_TOKEN=                     # Cloudflare Tunnel token for local n8n before the VPS exists (0.3 #7)

# ---------- Database (n8n state + Lead Velocity CRM) ----------
DB_POSTGRESDB_HOST=               # Postgres host for n8n
DB_POSTGRESDB_PORT=               # Postgres port
DB_POSTGRESDB_DATABASE=           # n8n database name
DB_POSTGRESDB_USER=               # n8n database user
DB_POSTGRESDB_PASSWORD=           # n8n database password
SUPABASE_URL=                     # existing Lead Velocity Supabase project URL (CRM tables: leads, bookings, outcomes…)
SUPABASE_SERVICE_ROLE_KEY=        # server-side key for n8n writes (never shipped to a browser)
SUPABASE_ANON_KEY=                # public anon key (page/portal reads under RLS)
SUPABASE_DB_URL=                  # direct Postgres connection string for the facts schema / transactions in W05

# ---------- Brand ----------
BRAND_ID=                         # brands.brand_id of the active consumer brand (sortmycover)
CONSUMER_DOMAIN=                  # sortmycover.co.za (.ics links /c/, join redirects /j/)
PORTAL_URL=                       # broker portal base URL (deep links in broker templates)
CONSOLE_URL=                      # ops console base URL (deep links in ops templates)
OPS_WHATSAPP_JONATHAN=            # E.164 for ops_* templates and Red alerts
OPS_WHATSAPP_KG=                  # E.164 for ops_* templates and Red alerts
OPS_EMAIL=                        # howzit@leadvelocity.co.za (email copies of Red/weekly)

# ---------- Meta: WhatsApp Cloud API ----------
META_GRAPH_VERSION=               # Graph API version string used in every call (e.g. v23.0; pinned, bumped deliberately)
META_APP_ID=                      # Meta app id (resumable uploads for template header samples, webhooks)
META_APP_SECRET=                  # app secret: verifies X-Hub-Signature-256 on every webhook (WhatsApp, Lead Ads, feed, Flow)
META_SYSTEM_USER_TOKEN=           # non-expiring system-user token (WABA, templates, Marketing API, CAPI)
META_WEBHOOK_VERIFY_TOKEN=        # hub.verify_token for webhook subscription handshake
META_BUSINESS_ID=                 # business portfolio id
WABA_ID=                          # WhatsApp Business Account id (template submission, quality rating)
PHONE_NUMBER_ID=                  # sending phone number id (messages, Flow encryption key registration)
STANDBY_PHONE_NUMBER_ID=          # warm standby number on the same WABA (quality-rating failover)
WHATSAPP_TEST_PHONE_NUMBER_ID=    # Meta test number used for staging before the WABA display name is approved
WHATSAPP_TEST_RECIPIENTS=         # comma-separated E.164 allow-list for staging sends (synthetic tests only)

# ---------- Meta: WhatsApp Flows (W28) ----------
BOOKING_FLOW_ID=                  # published booking Flow id (broker_intro_slots_v2 FLOW button)
RESCHEDULE_FLOW_ID=               # published reschedule Flow id (reschedule_offer_v2 FLOW button)
FLOW_ENDPOINT_URL=                # HTTPS URL of the Flow data_exchange endpoint (behind Traefik)
FLOW_PRIVATE_KEY=                 # RSA-2048 private key PEM (decrypts Flow requests); single line with \n escapes
FLOW_PRIVATE_KEY_PASSPHRASE=      # passphrase for FLOW_PRIVATE_KEY, if set
FLOW_PUBLIC_KEY=                  # matching public key PEM registered via /{PHONE_NUMBER_ID}/whatsapp_business_encryption

# ---------- Meta: Pages, Lead Ads, Ads, CAPI ----------
PAGE_ID=                          # SortMyCover Facebook Page id (Lead Ads, comments, Messenger)
PAGE_ACCESS_TOKEN=                # page token for comment replies / private replies / Messenger (W30, W31)
IG_USER_ID=                       # Instagram professional account id (IG comments + DMs)
AD_ACCOUNT_ID=                    # act_… primary ad account (W21 insights, budget changes via console)
STANDBY_AD_ACCOUNT_ID=            # standby ad account in the same portfolio
PIXEL_ID=                         # Meta Pixel / dataset id for web CAPI events (Lead, Schedule)
DATASET_ID=                       # dataset id for business-messaging CAPI (CTWA Lead/Schedule) and offline Attended
CAPI_TEST_EVENT_CODE=             # test_event_code for staging (removed in production)

# ---------- Microsoft Graph / Entra ID (Outlook calendar, Teams, howzit@ mailbox) ----------
MS_TENANT_ID=                     # Lead Velocity M365 tenant id
MS_CLIENT_ID=                     # Entra app registration (client) id — one app for brokers + howzit@
MS_CLIENT_SECRET=                 # Entra app client secret (rotated; expiry tracked by W22)
MS_REDIRECT_URI=                  # OAuth redirect for broker "Connect Outlook" in the portal
MS_SCOPES=                        # Calendars.ReadWrite OnlineMeetings.ReadWrite User.Read Mail.Read Mail.Send offline_access
MS_ADMIN_CONSENT_URL=             # admin-consent link shown in the portal when a broker tenant blocks app consent (0.3 #4)
HOWZIT_MAILBOX=                   # howzit@leadvelocity.co.za (sends invites, receives NDRs, W17 inContact parsing)
MS_GRAPH_SUBSCRIPTION_SECRET=     # clientState for Graph change-notification subscriptions (bounces, mail)
SHARED_FALLBACK_CALENDAR_ID=      # shared calendar used when a broker tenant blocks consent (0.3 #4 fallback)
TOKEN_ENC_KEY=                    # key used to encrypt broker OAuth refresh tokens at rest

# ---------- Google (optional, Google-Workspace brokers only) ----------
GOOGLE_CLIENT_ID=                 # OAuth client for Google Calendar + Meet (published "In production")
GOOGLE_CLIENT_SECRET=             # OAuth client secret
GOOGLE_REDIRECT_URI=              # OAuth redirect for "Connect Google Calendar"

# ---------- Zoom (optional, per broker) ----------
ZOOM_CLIENT_ID=                   # Zoom Marketplace OAuth app id
ZOOM_CLIENT_SECRET=               # Zoom Marketplace OAuth app secret
ZOOM_REDIRECT_URI=                # OAuth redirect for "Connect Zoom"
ZOOM_WEBHOOK_SECRET=              # Zoom event webhook verification secret

# ---------- Twilio (Lookup, SMS fallback, Red-alert voice) ----------
TWILIO_ACCOUNT_SID=               # Twilio account SID
TWILIO_API_KEY_SID=               # Twilio API key SID (preferred over auth token)
TWILIO_API_KEY_SECRET=            # Twilio API key secret
TWILIO_LOOKUP_ENABLED=            # true | false — line-type check at W01/W07 (rejects landline/VoIP)
TWILIO_SMS_FROM=                  # sender id / number for undeliverable-WhatsApp SMS fallback (W06)
TWILIO_VOICE_FROM=                # number for the 4-h unacknowledged Red alert call (only voice use, 6.8b)

# ---------- Email validation (W05 / Flow) ----------
EMAIL_PROBE_ENABLED=              # false by default; ZeroBounce-class probe only if bounce rate > 5%
EMAIL_PROBE_API_KEY=              # probe provider key (unused while disabled)

# ---------- Anthropic (conversation agent, briefs, judge) ----------
ANTHROPIC_API_KEY=                # Claude API key (W07, W11 briefs, W30/W31, W32, W33)
ANTHROPIC_MODEL_FAST=             # Haiku-class model id for intent/reply/guardrail turns (4A)
ANTHROPIC_MODEL_STRONG=           # stronger model id for ambiguous/sensitive turns and the judge (4A)
TRANSCRIBE_API_KEY=               # speech-to-text key for broker voice notes (W12) and intro media captions (W23)

# ---------- Payments (W16, W19, W25) ----------
PAYSTACK_SECRET_KEY=              # Paystack secret key (Instant EFT/card, plans)
PAYSTACK_PUBLIC_KEY=              # Paystack public key (checkout)
PAYSTACK_WEBHOOK_SECRET=          # signature verification for Paystack webhooks (HMAC uses secret key if not separate)
OZOW_SITE_CODE=                   # Ozow site code (Instant EFT alternative)
OZOW_PRIVATE_KEY=                 # Ozow hash key
OZOW_API_KEY=                     # Ozow API key
FNB_INCONTACT_SENDER=             # sender address filter for FNB inContact emails parsed by W17
BANK_ACCOUNT_REF_PREFIX=          # prefix for unique manual-EFT references (e.g. SMC-)

# ---------- Hosting / deploy (W26) ----------
VPS_HOST=                         # VPS IP/host (set by W26 after first payment)
VPS_SSH_USER=                     # deploy user
VPS_SSH_KEY_PATH=                 # path to deploy key on the operator machine (key itself never in repo)
TRAEFIK_ACME_EMAIL=               # Let's Encrypt contact for Traefik certificates
BACKUP_S3_ENDPOINT=               # off-box backup target endpoint
BACKUP_S3_BUCKET=                 # backup bucket
BACKUP_S3_ACCESS_KEY=             # backup access key
BACKUP_S3_SECRET_KEY=             # backup secret key

# ---------- Security / abuse (6B.5) ----------
TURNSTILE_SECRET_KEY=             # Cloudflare Turnstile server secret for /lead and /book
RATE_LIMIT_PER_IP_PER_HOUR=       # submissions per IP per hour on /lead and /book
INTERNAL_HMAC_SECRET=             # signs page→n8n calls (/lead, /slots, /book) and portal deep links
LOG_REDACTION=                    # true — redact numbers/emails in logs (0.3 #10)

# ---------- Feature flags ----------
BOOKING_UI_DEFAULT=               # list | flow — default for brands.booking_ui (list until the Flow is published)
VOICE_FALLBACK_ENABLED=           # false — optional voice step for unbooked leads after 24 h (W08), off by default
DRY_RUN_SENDS=                    # true in staging: messages to non-allow-listed numbers are logged, not sent
