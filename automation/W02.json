{
  "name": "W02 Lead intake (Meta instant form)",
  "nodes": [
    {
      "id": "n01",
      "name": "Sticky: read me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ],
      "parameters": {
        "width": 700,
        "height": 320,
        "content": "W02 Lead Ads webhook (leadgen). Verify X-Hub-Signature-256 over the raw body -> 200 immediately -> fetch lead via Graph (retry x3 in meta-ads.js) -> idempotency on leadgen_id -> backstop qualification (bands + consent; form conditional logic is not trusted) -> same path as W01 via the sub-workflow \"W01 Lead core\": dedupe 90 d, Twilio line-type, route to broker, store, CAPI Lead, first WhatsApp < 60 s. Out-of-band / no-consent leads are NOT stored and never enter the automation (2.1.7); only an anonymous counter row is written. CONTRACT ASSUMPTION: automation/tests/W01.test.mjs does not exist yet; payload below follows crm-gap leads columns and must be reconciled by automation-engineer. Needs env META_APP_SECRET, META_WEBHOOK_VERIFY_TOKEN, META_SYSTEM_USER_TOKEN."
      }
    },
    {
      "id": "n02",
      "name": "Lead Ads webhook (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "meta-leadgen",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "webhookId": "w02-leadgen-post"
    },
    {
      "id": "n03",
      "name": "Verify signature + parse leadgen events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const M = require('/opt/lv/automation/ads/meta-ads.js');\nconst it = $input.first();\nconst raw = it.binary && it.binary.data ? Buffer.from(it.binary.data.data, 'base64').toString('utf8') : (it.json.rawBody || JSON.stringify(it.json.body));\nconst sig = (it.json.headers || {})['x-hub-signature-256'];\nif (!M.verifyWebhookSignature(raw, sig, $env.META_APP_SECRET)) return [{ json: { valid: false } }];\nconst events = M.parseLeadgenWebhook(JSON.parse(raw));\nif (!events.length) return [{ json: { valid: true, empty: true } }];\nreturn events.map((e) => ({ json: { valid: true, ...e } }));"
      }
    },
    {
      "id": "n04",
      "name": "Respond 200 / 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        -120
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.valid ? \"ok\" : \"bad signature\" }}",
        "options": {
          "responseCode": "={{ $json.valid ? 200 : 401 }}"
        }
      }
    },
    {
      "id": "n05",
      "name": "Valid and has a lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        60
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ String($json.valid && !$json.empty) }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "n06",
      "name": "Idempotency: already stored?",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        60
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- physical column, full unique index leads_leadgen_full_uidx (06). The insert itself is W01's: it must use INSERT INTO public.leads (leadgen_id, ...) ... ON CONFLICT (leadgen_id) DO NOTHING, so a webhook re-delivery racing this check still stores one lead.\nSELECT id FROM public.leads WHERE leadgen_id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.leadgen_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "n07",
      "name": "Fetch lead via Graph + backstop",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        60
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const M = require('/opt/lv/automation/ads/meta-ads.js');\nconst client = M.createClient({ token: $env.META_SYSTEM_USER_TOKEN, apiVersion: $env.META_API_VERSION || 'v23.0', maxInlineWaitMs: 5000 });\nconst ev = $('Verify signature + parse leadgen events').item.json;\nif ($input.item.json.id) return [{ json: { action: 'duplicate', leadgen_id: ev.leadgen_id } }]; // webhook re-delivery\nconst lead = await client.fetchLead(ev.leadgen_id);\nconst q = M.qualifyLead(lead);\nif (!q.qualified) return [{ json: { action: 'routed_out', leadgen_id: ev.leadgen_id, form_id: lead.form_id, ad_id: lead.ad_id, reasons: q.reasons } }];\n// Payload for \"W01 Lead core\" (same contract as the web path; origin = lead_ad). No raw Meta blobs, no age/budget beyond the bands.\nreturn [{ json: { action: 'ingest', lead: {\n  origin: 'lead_ad', leadgen_id: lead.leadgen_id, form_id: lead.form_id, full_name: lead.full_name, mobile_raw: lead.phone, email: lead.email || null,\n  campaign_id: lead.campaign_id, adset_id: lead.adset_id, ad_id: lead.ad_id, concept: lead.ad_parts && lead.ad_parts.concept, angle: lead.ad_parts && lead.ad_parts.angle,\n  platform: lead.platform, age_band: lead.answers.age_band, budget_band: lead.answers.budget_band, preferred_method_ok: true, bond_children: q.bond_children,\n  consent: { given: true, source: 'meta_instant_form', form_id: lead.form_id, text_version: 'CONSENT-NAMED-v1+CONSENT-ADS-v1', raw: lead.consent_raw, captured_at: lead.created_time },\n  lead_event_id: 'evt_' + lead.leadgen_id + '_lead', is_synthetic: false } } }];"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "n08",
      "name": "Action?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1100,
        60
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "ingest",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "s1",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "ingest",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "routed_out",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "s2",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "routed_out",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "n09",
      "name": "W01 Lead core (validate, dedupe, route, store, CAPI Lead)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1320,
        -60
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "W01 Lead core"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "n10",
      "name": "Count routed-out (anonymous, no PII)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1320,
        80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ops.notifications (kind, \"to\", channel, severity, status, source, dedupe_key, what, body)\nSELECT 'lead_routed_out', 'console', 'console', 'info', 'sent', 'W02', $1::text, 'Lead Ad lead routed out (not qualified)', jsonb_build_object('ad_id', $2::text)\nWHERE NOT EXISTS (SELECT 1 FROM ops.notifications n WHERE n.dedupe_key = $1::text AND n.created_at > now() - interval '24 hours')\nRETURNING 1; -- anonymous: ad id only, reasons stay in the execution data and the lead is not stored (2.1.7).",
        "options": {
          "queryReplacement": "={{ [ \"routed_out:\" + $json.ad_id + \":\" + $json.leadgen_id, String($json.ad_id || '') ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "LV Supabase - n8n_app (least privilege)"
        }
      }
    },
    {
      "id": "n11",
      "name": "Duplicate delivery: ignore",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1320,
        220
      ],
      "parameters": {}
    },
    {
      "id": "n12",
      "name": "W22 Alerts: W02 failure",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        880,
        260
      ],
      "parameters": {
        "source": "database",
