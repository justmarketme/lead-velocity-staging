          [
            "Mark",
            "Lerato M.",
            "Microsoft Teams",
            "Tue 13 Oct, 11:30",
            "Wed 14 Oct, 14:00"
          ]
        ]
      }
    },
    {
      "type": "FOOTER",
      "text": "SortMyCover by Lead Velocity"
    },
    {
      "type": "BUTTONS",
      "buttons": [
        {
          "type": "URL",
          "text": "Open the day",
          "url": "https://app.leadvelocity.co.za/s/{{1}}",
