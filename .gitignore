# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.cursor
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
.env*.local

# Environment files — NEVER commit these
.env
.env.*
!.env.example

# Local debug & admin scripts — may contain credentials
test-db.js
test-login.js
run-sql.js
reset-admin.js
run-sql-esm.js
test-*.js
test-*.mjs
register-discord.js

# Output & logs
*.txt
*.json
!deno.json
!deno.jsonc
!package.json
!package-lock.json
!tsconfig.json

# Cursor / IDE config that may contain tokens (e.g. MCP, GitHub PAT)
.cursor/
supabase/.temp/

# SortMyCover build — secrets and keys never committed (pre-commit guard in .githooks/)
*.pem
*.key
credentials*
# task graph is tracked despite the *.json rule above
!build/tasks.json
# SortMyCover build deliverables are tracked (exceptions to the *.json / *.txt rules above)
!automation/**/*.json
!automation/**/*.txt
!deliverables/**/*.json
!deliverables/**/*.txt
!landing/**/*.json
!brand/**/*.json
!build/*.json
!build/*.jsonl
!evals/**/*.json
!community/**/*.txt

# W24 evidence files hold PII hashes — never committed
compliance/
*.whl
!data/**/*.json
!optimisation/**/*.json
!analytics/**/*.json
!portal/**/*.json
!community/**/*.json
!conversation/**/*.json

# Client invoices carry bank details (NH-61) - never committed
deliverables/billing/invoice-*
deliverables/billing/outbox-*/

# Client-specific copies stay out of git
deliverables/contracts-drafter/lead-generation-agreement/*mark-weston*
deliverables/contracts-drafter/lead-generation-agreement/email-to-*.md
scripts/out/
