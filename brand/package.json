    "all": "npm run tokens && npm run logos && npm run favicon && npm run render && npm run video && npm run sync",
    "bible": "node scripts/build-bible-pdf.mjs",
    "highlights": "node scripts/build-highlights.mjs",
    "teal": "node scripts/build-teal-logos.mjs"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.2.8",
