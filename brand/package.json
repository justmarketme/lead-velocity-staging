{
  "name": "sortmycover-brand",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SortMyCover brand system: tokens, logo SVGs, favicon set, templates, exports. Single source every surface imports.",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "logos": "node scripts/build-logos.mjs",
    "favicon": "node scripts/build-favicon.mjs",
    "render": "node exports/render.mjs",
    "video": "node scripts/render-intro-video.mjs",
