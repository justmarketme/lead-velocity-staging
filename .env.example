# Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file — it is in .gitignore.

VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
# Server-side only (Supabase Edge Function secret for gemini-proxy; never VITE_-prefixed)
GEMINI_API_KEY="your-gemini-api-key"

# SortMyCover portal/console (public values only: every VITE_ var is inlined into the browser bundle). See deliverables/devops-security/static-hosting.md §5
VITE_SMC_ENABLED=""
VITE_PAYSTACK_ENABLED=""   # NH-61: Instant EFT/card buttons in the portal; default off (EFT in advance only)
VITE_N8N_WEBHOOK_BASE=""
VITE_MS_OAUTH_URL=""
VITE_MS_ADMIN_CONSENT_URL=""
VITE_SMC_CHECKOUT_URL=""
VITE_SMC_INTRO_MEDIA_URL=""
VITE_SMC_EXPLAINER_URL=""
VITE_SMC_EXPLAINER_VTT=""
VITE_SMC_CLIPS_BASE=""
VITE_SMC_SUPPORT_WA=""
VITE_SMC_MEDIA_BUCKET="broker-media"

# W34 POPIA operations (n8n only; server-side, never VITE_). Defaults in brackets; the privacy notice PN-v1.1
# placeholder each one must equal is named after the arrow, so the page and the purge never differ (brief Q11).
# W34_LEAD_RETENTION_MONTHS=""        # [12] -> {{retention_lead_months}}
# W34_UNFINISHED_RETENTION_HOURS=""   # [72] -> {{retention_unfinished_hours}} (unfinished WhatsApp chats, wa_threads)
# W34_NONFIT_RETENTION_HOURS=""       # [24] -> {{retention_nonfit_hours}}
# W34_CONSENT_RETENTION_YEARS=""      # [5]  -> {{retention_consent_years}}
# W34_DSR_RECORD_YEARS="" W34_WA_THREAD_GRACE_HOURS="" W34_DSR_DUE_DAYS="" W34_DSR_WARN_DAYS="" W34_DSR_VERIFY_DAYS=""   # [5, 0, 30 (max 30), 7, 5] internal, not in the notice
# W34_DSR_ERASE_ACTION="" W34_BATCH_LIMIT="" W34_IO_RECIPIENT="" W34_TEST_MODE="" W34_DRY_RUN=""   # [pseudonymise, 500, jonathan, false, false]
# W34_EVIDENCE_DIR="" W34_EXPORT_DIR=""
# W34_MEDIA_ERASE_URL=""              # <SUPABASE_URL>/storage/v1/object/broker-media (LOCAL-STAGING.md 1d)
