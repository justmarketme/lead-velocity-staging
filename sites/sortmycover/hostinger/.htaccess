# GENERATED by scripts/gen-config.mjs from config/site.json + config/angles.json. Do not edit by hand.
# Deploy: upload dist/ to the apex document root; point every campaign subdomain's document root at the SAME folder (see README).
Options -Indexes +FollowSymLinks
DirectorySlash On
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# https
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# www and .com -> apex
RewriteCond %{HTTP_HOST} ^(www\.)?sortmycover\.com$ [NC]
RewriteRule ^(.*)$ https://sortmycover.co.za/$1 [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.sortmycover\.co\.za$ [NC]
RewriteRule ^(.*)$ https://sortmycover.co.za/$1 [L,R=301]
# old .html URLs
RewriteRule ^about\.html$ /about/ [L,R=301]
RewriteRule ^book\.html$ /book/ [L,R=301]
RewriteRule ^how-we-make-money\.html$ /how-we-make-money/ [L,R=301]
RewriteRule ^complaints\.html$ /complaints/ [L,R=301]
RewriteRule ^privacy\.html$ /privacy/ [L,R=301]
RewriteRule ^terms\.html$ /terms/ [L,R=301]
RewriteRule ^learn/what-is-a-life-cover-gap\.html$ /learn/what-is-a-life-cover-gap/ [L,R=301]
RewriteRule ^learn/what-happens-on-a-30-minute-call\.html$ /learn/what-happens-on-a-30-minute-call/ [L,R=301]
RewriteRule ^learn/how-to-read-your-payslips-cover-line\.html$ /learn/how-to-read-your-payslips-cover-line/ [L,R=301]
RewriteRule ^learn/how-sortmycover-works\.html$ /learn/how-sortmycover-works/ [L,R=301]
RewriteRule ^learn/life-events-that-change-what-you-need\.html$ /learn/life-events/ [L,R=301]
RewriteRule ^index\.html$ / [L,R=301]
RewriteRule ^learn/index\.html$ /learn/ [L,R=301]
# apex: campaign pages live on their own host
RewriteCond %{HTTP_HOST} ^sortmycover\.co\.za$ [NC]
RewriteRule ^(?:_c/)?adviser-conversation/?$ https://adviser-conversation.sortmycover.co.za/ [L,R=307]
RewriteCond %{HTTP_HOST} ^sortmycover\.co\.za$ [NC]
RewriteRule ^(?:_c/)?new-bond/?$ https://new-bond.sortmycover.co.za/ [L,R=307]
RewriteCond %{HTTP_HOST} ^sortmycover\.co\.za$ [NC]
RewriteRule ^(?:_c/)?salary-stops/?$ https://salary-stops.sortmycover.co.za/ [L,R=307]
RewriteCond %{HTTP_HOST} ^sortmycover\.co\.za$ [NC]
RewriteRule ^(?:_c/)?cover-gap/?$ https://cover-gap.sortmycover.co.za/ [L,R=307]
RewriteCond %{HTTP_HOST} ^sortmycover\.co\.za$ [NC]
RewriteRule ^(?:_c/)?owners-directors/?$ https://owners-directors.sortmycover.co.za/ [L,R=307]
RewriteCond %{HTTP_HOST} ^sortmycover\.co\.za$ [NC]
RewriteRule ^(?:_c/)?new-baby/?$ https://new-baby.sortmycover.co.za/ [L,R=307]
# campaign hosts: '/' and '/thanks/' map into _c/<slug>/; everything else goes to the apex
RewriteCond %{HTTP_HOST} ^adviser-conversation\.sortmycover\.co\.za$ [NC]
RewriteRule ^$ /_c/adviser-conversation/index.html [L]
RewriteCond %{HTTP_HOST} ^adviser-conversation\.sortmycover\.co\.za$ [NC]
RewriteRule ^thanks/?$ /_c/adviser-conversation/thanks/index.html [L]
RewriteCond %{HTTP_HOST} ^new-bond\.sortmycover\.co\.za$ [NC]
RewriteRule ^$ /_c/new-bond/index.html [L]
RewriteCond %{HTTP_HOST} ^new-bond\.sortmycover\.co\.za$ [NC]
RewriteRule ^thanks/?$ /_c/new-bond/thanks/index.html [L]
RewriteCond %{HTTP_HOST} ^salary-stops\.sortmycover\.co\.za$ [NC]
RewriteRule ^$ /_c/salary-stops/index.html [L]
RewriteCond %{HTTP_HOST} ^salary-stops\.sortmycover\.co\.za$ [NC]
RewriteRule ^thanks/?$ /_c/salary-stops/thanks/index.html [L]
RewriteCond %{HTTP_HOST} ^cover-gap\.sortmycover\.co\.za$ [NC]
RewriteRule ^$ /_c/cover-gap/index.html [L]
RewriteCond %{HTTP_HOST} ^cover-gap\.sortmycover\.co\.za$ [NC]
RewriteRule ^thanks/?$ /_c/cover-gap/thanks/index.html [L]
RewriteCond %{HTTP_HOST} ^owners-directors\.sortmycover\.co\.za$ [NC]
RewriteRule ^$ /_c/owners-directors/index.html [L]
RewriteCond %{HTTP_HOST} ^owners-directors\.sortmycover\.co\.za$ [NC]
RewriteRule ^thanks/?$ /_c/owners-directors/thanks/index.html [L]
RewriteCond %{HTTP_HOST} ^new-baby\.sortmycover\.co\.za$ [NC]
RewriteRule ^$ /_c/new-baby/index.html [L]
RewriteCond %{HTTP_HOST} ^new-baby\.sortmycover\.co\.za$ [NC]
RewriteRule ^thanks/?$ /_c/new-baby/thanks/index.html [L]
RewriteCond %{HTTP_HOST} ^[a-z0-9-]+\.sortmycover\.co\.za$ [NC]
RewriteRule ^sitemap\.xml$ - [R=404,L]
RewriteCond %{HTTP_HOST} ^[a-z0-9-]+\.sortmycover\.co\.za$ [NC]
RewriteCond %{REQUEST_URI} !^/(assets/|fonts/|robots\.txt|favicon|apple-touch-icon|icon-|mask-icon|manifest|browserconfig|mstile|_c/)
RewriteRule ^(.+)$ https://sortmycover.co.za/$1 [L,R=307]
</IfModule>

<IfModule mod_headers.c>
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://connect.facebook.net https://challenges.cloudflare.com; style-src 'self'; img-src 'self' https://www.facebook.com; font-src 'self'; connect-src 'self' https://n8n.leadvelocity.co.za https://www.facebook.com https://connect.facebook.net; frame-src https://challenges.cloudflare.com; form-action 'self' https://n8n.leadvelocity.co.za; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=86400"
Header always set X-Frame-Options "DENY"
SetEnvIfNoCase Host "\.sortmycover\.co\.za$" CAMPAIGN_HOST=1
Header always set X-Robots-Tag "noindex, nofollow" env=CAMPAIGN_HOST
<FilesMatch "\.(html)$">
  Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
<FilesMatch "\.(js|css|woff2)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(png|ico|svg|webmanifest)$">
  Header set Cache-Control "public, max-age=86400"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
AddType application/manifest+json .webmanifest
