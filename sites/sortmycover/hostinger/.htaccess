RewriteRule ^thanks/?$ /_c/myth-bust/thanks/index.html [L]
RewriteCond %{HTTP_HOST} ^new-baby\.sortmycover\.co\.za$ [NC]
RewriteRule ^$ /_c/new-baby/index.html [L]
RewriteCond %{HTTP_HOST} ^new-baby\.sortmycover\.co\.za$ [NC]
RewriteRule ^thanks/?$ /_c/new-baby/thanks/index.html [L]
RewriteCond %{HTTP_HOST} ^self-employed\.sortmycover\.co\.za$ [NC]
RewriteRule ^$ /_c/self-employed/index.html [L]
RewriteCond %{HTTP_HOST} ^self-employed\.sortmycover\.co\.za$ [NC]
RewriteRule ^thanks/?$ /_c/self-employed/thanks/index.html [L]
RewriteCond %{HTTP_HOST} ^turned-40\.sortmycover\.co\.za$ [NC]
RewriteRule ^$ /_c/turned-40/index.html [L]
RewriteCond %{HTTP_HOST} ^turned-40\.sortmycover\.co\.za$ [NC]
RewriteRule ^thanks/?$ /_c/turned-40/thanks/index.html [L]
RewriteCond %{HTTP_HOST} ^virtual\.sortmycover\.co\.za$ [NC]
RewriteRule ^$ /_c/virtual/index.html [L]
RewriteCond %{HTTP_HOST} ^virtual\.sortmycover\.co\.za$ [NC]
RewriteRule ^thanks/?$ /_c/virtual/thanks/index.html [L]
RewriteCond %{HTTP_HOST} ^what-the-call\.sortmycover\.co\.za$ [NC]
RewriteRule ^$ /_c/what-the-call/index.html [L]
RewriteCond %{HTTP_HOST} ^what-the-call\.sortmycover\.co\.za$ [NC]
RewriteRule ^thanks/?$ /_c/what-the-call/thanks/index.html [L]
RewriteCond %{HTTP_HOST} ^c13-check-not-buy\.sortmycover\.co\.za$ [NC]
RewriteRule ^$ /_c/c13-check-not-buy/index.html [L]
RewriteCond %{HTTP_HOST} ^c13-check-not-buy\.sortmycover\.co\.za$ [NC]
RewriteRule ^thanks/?$ /_c/c13-check-not-buy/thanks/index.html [L]
RewriteCond %{HTTP_HOST} ^[a-z0-9-]+\.sortmycover\.co\.za$ [NC]
RewriteCond %{REQUEST_URI} !^/(assets/|fonts/|robots\.txt|favicon|apple-touch-icon|icon-|mask-icon|manifest|browserconfig|mstile|_c/)
RewriteRule ^(.+)$ https://sortmycover.co.za/$1 [L,R=307]
</IfModule>

<IfModule mod_headers.c>
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://connect.facebook.net https://challenges.cloudflare.com; style-src 'self'; img-src 'self' https://www.facebook.com; font-src 'self'; connect-src 'self' https://n8n.leadvelocity.co.za https://www.facebook.com https://connect.facebook.net; frame-src https://challenges.cloudflare.com; form-action 'self' https://n8n.leadvelocity.co.za; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Frame-Options "DENY"
SetEnvIfNoCase Host "\.sortmycover\.co\.za$" CAMPAIGN_HOST=1
Header always set X-Robots-Tag "noindex, nofollow" env=CAMPAIGN_HOST
<FilesMatch "\.(html)$">
  Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
<FilesMatch "\.(js|css|woff2)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(png|ico|svg|webmanifest)$">
  Header set Cache-Control "public, max-age=86400"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
AddType application/manifest+json .webmanifest
